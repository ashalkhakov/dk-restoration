#include "ui/menudef.h"
#include "ui/dk_defs.h"

// The panels that open on the left of the main menu, one per plaque.
// Positions are Daikatana's (dk_menu_*.cpp), less the panel corner (80, 90).



// the save and load panels' list of saves (FEEDER_SAVEGAMES): the name and
// when it was saved, to the minute; DOUBLECLICK what a double click does
#define DK_SAVE_LIST( X, Y, W, H, DOUBLECLICK ) \
	itemDef { \
		name savelist \
		rect X Y W H \
		type ITEM_TYPE_LISTBOX \
		style WINDOW_STYLE_EMPTY \
		elementwidth W \
		elementheight 16 \
		textscale DK_TS_SMALL \
		elementtype LISTBOX_TEXT \
		feeder FEEDER_SAVEGAMES \
		border 1 \
		bordersize 2 \
		bordercolor .5 .1 .1 1 \
		forecolor DK_GOLD \
		outlinecolor DK_SELECT \
		visible 1 \
		columns 2	2 120 14		124 110 16 \
		doubleClick { DOUBLECLICK } \
	}

// the selected save: its map's picture beside the list, its episode and
// map at Y, and how the player was at INFO_Y, under it
#define DK_SAVE_DETAILS( X, Y, INFO_Y ) \
	itemDef { \
		rect 285 35 120 100 \
		ownerdraw UI_SAVE_SHOT \
		border 1 \
		bordersize 1 \
		bordercolor .5 .1 .1 1 \
		decoration \
		visible 1 \
	} \
	itemDef { \
		rect X Y 380 16 \
		ownerdraw UI_SAVE_TITLE \
		textscale DK_TS \
		forecolor DK_BRIGHT \
		decoration \
		visible 1 \
	} \
	itemDef { \
		rect X INFO_Y 380 80 \
		ownerdraw UI_SAVE_INFO \
		textscale DK_TS_SMALL \
		forecolor DK_GOLD \
		decoration \
		visible 1 \
	}

// a button shown when FLAGS hold
#define DK_SAVE_BUTTON( X, Y, LABEL, FLAGS, ACTIONS ) \
	itemDef { \
		rect X Y 105 20 \
		style WINDOW_STYLE_SHADER \
		background "ui/assets/dk/buttons/medium_up" \
		ownerdrawflag FLAGS \
		decoration \
		visible 1 \
	} \
	itemDef { \
		type ITEM_TYPE_BUTTON \
		rect X Y 105 20 \
		text LABEL \
		textalign ITEM_ALIGN_CENTER \
		textalignx 52 \
		textaligny 15 \
		textscale DK_TS \
		forecolor DK_GOLD \
		ownerdrawflag FLAGS \
		visible 1 \
		action { play DK_SND_PRESS ; ACTIONS } \
	}

// a key binding row, a page's title and an arrow, in a page's group and
// shown with it
#define DK_KEY_BIND( PAGE, VISIBLE, X, Y, LABEL, COMMAND ) \
	itemDef { \
		type ITEM_TYPE_BIND \
		group PAGE \
		text LABEL \
		cvar COMMAND \
		rect X Y 195 16 \
		textaligny 13 \
		textscale DK_TS_SMALL \
		forecolor DK_GOLD \
		visible VISIBLE \
	}
#define DK_KEY_TITLE( PAGE, VISIBLE, X, Y, TEXT ) \
	itemDef { \
		group PAGE \
		rect X Y 300 18 \
		text TEXT \
		textaligny 14 \
		textscale DK_TS \
		forecolor DK_BRIGHT \
		decoration \
		visible VISIBLE \
	}
#define DK_KEY_ARROW( PAGE, VISIBLE, X, Y, FACE, ACTIONS ) \
	itemDef { \
		group PAGE \
		rect X Y 20 20 \
		style WINDOW_STYLE_SHADER \
		background FACE \
		decoration \
		visible VISIBLE \
	} \
	itemDef { \
		type ITEM_TYPE_BUTTON \
		group PAGE \
		rect X Y 20 20 \
		visible VISIBLE \
		action { play DK_SND_PRESS ; ACTIONS } \
	}

{
	// Single player: Daikatana's new game (dk_menu_newgame.cpp), its
	// difficulty, Hiro's pictures over it; the campaign (g_gametype 3) from
	// the first map, carrying nothing (g_persistant 0)
	menuDef {
		DK_PANEL( dk_singleplayer )

		DK_LABEL_BRIGHT( 140, 30, "Select Difficulty:" )

		DK_PIC( 8, 60, 96, 192, "pics/menu/skill_0" )
		DK_PIC( 138, 60, 96, 192, "pics/menu/skill_1" )
		DK_PIC( 268, 60, 96, 192, "pics/menu/skill_2" )

		DK_BUTTON_MEDIUM( 2, 260, "Ronin", setcvar g_skill 0 ; DK_NEW_GAME )
		DK_BUTTON_MEDIUM( 132, 260, "Samurai", setcvar g_skill 1 ; DK_NEW_GAME )
		DK_BUTTON_MEDIUM( 262, 260, "Shogun", setcvar g_skill 2 ; DK_NEW_GAME )
	}

	// Load Game: Daikatana's list of saves (dk_menu_loadgame.cpp), newest
	// first, and the selected one's map, how the player was, when it was
	// saved (ui_saves.c)
	menuDef {
		DK_PANEL( dk_loadgame )
		onOpen { uiScript LoadSaves }

		DK_LABEL_BRIGHT( 20, 10, "Load a saved game:" )
		DK_SAVE_LIST( 20, 35, 250, 130, uiScript LoadSave )
		DK_SAVE_DETAILS( 20, 172, 188 )

		DK_SAVE_BUTTON( 285, 155, "Load", UI_SHOW_SAVE_SELECTED, uiScript LoadSave )
		DK_SAVE_BUTTON( 285, 180, "Delete", UI_SHOW_SAVE_SELECTED, uiScript DeleteSave )
	}

	// Save Game: the same list; a name, the map's by default, a save picked
	// to save over it (dk_menu_savegame.cpp). Everything ends above 325, the
	// bottom of Daikatana's panel area (SCREEN_TOP + SCREEN_HEIGHT)
	menuDef {
		DK_PANEL( dk_savegame )
		onOpen { uiScript LoadSaves ; uiScript SaveName }

		DK_LABEL_BRIGHT( 20, 10, "Save the game (a Save Gem each):" )
		DK_SAVE_LIST( 20, 35, 250, 130, uiScript SaveGame ; DK_CLOSE_PANELS ; uiScript closeingame )
		DK_SAVE_DETAILS( 20, 172, 188 )

		DK_LABEL( 20, 268, "Name:" )
		DK_FIELD( 80, 266, "ui_saveName", 32 )
		DK_BUTTON_MEDIUM( 285, 266, "Save", uiScript SaveGame ; DK_CLOSE_PANELS ; uiScript closeingame )
		itemDef {
			rect 20 290 250 16
			ownerdraw UI_SAVE_GEMS
			textscale DK_TS_SMALL
			forecolor DK_GOLD
			decoration
			visible 1
		}
	}

	// Multiplayer: who you are and where to play
	menuDef {
		DK_PANEL( dk_multiplayer )

		DK_LABEL( 20, 20, "Player Name" )
		DK_FIELD( 20, 40, "name", 32 )

		DK_BUTTON_LONG( 20, 75, "Find an Internet Game", setcvar ui_netSource 2 ; close dk_multiplayer ; open dk_join )
		DK_BUTTON_LONG( 20, 105, "Find a Local Game", setcvar ui_netSource 0 ; close dk_multiplayer ; open dk_join )
		DK_BUTTON_LONG( 20, 135, "Start a Multiplayer Game", close dk_multiplayer ; open dk_host )

		DK_PIC( 20, 175, 64, 64, "pics/interface/mplayer" )

		DK_MULTI( 20, 270, "Connect Rate:", "rate", { "28.8k" 2500 "56.6k" 4000 "ISDN" 5000 "Cable/DSL" 25000 "T1/LAN" 90000 } )
	}

	// Join: the server list
	menuDef {
		DK_PANEL( dk_join )
		onOpen { uiScript UpdateFilter }

		DK_BACK( 20, 15, close dk_join ; open dk_multiplayer )
		DK_LABEL_BRIGHT( 50, 16, "Join a Game" )

		itemDef {
			name serverlist
			rect 20 45 376 230
			type ITEM_TYPE_LISTBOX
			style WINDOW_STYLE_EMPTY
			elementwidth 376
			elementheight 16
			textscale DK_TS_SMALL
			elementtype LISTBOX_TEXT
			feeder FEEDER_SERVERS
			border 1
			bordersize 2
			bordercolor .5 .1 .1 1
			forecolor DK_GOLD
			outlinecolor DK_SELECT
			visible 1
			columns 4	2 40 24		200 20 10		275 20 5		335 20 4
			doubleClick { uiScript JoinServer }
		}

		DK_LABEL( 22, 280, "Server" )
		DK_LABEL( 220, 280, "Map" )
		DK_LABEL( 295, 280, "Players" )
		DK_LABEL( 355, 280, "Ping" )

		DK_BUTTON_MEDIUM( 20, 310, "Refresh", uiScript RefreshServers )
		DK_BUTTON_MEDIUM( 290, 310, "Join", uiScript JoinServer )
	}

	// Host: game type, map and limits
	menuDef {
		DK_PANEL( dk_host )
		onOpen { uiScript loadArenas }

		DK_BACK( 20, 15, close dk_host ; open dk_multiplayer )
		DK_LABEL_BRIGHT( 50, 16, "Start a Game" )

		itemDef {
			type ITEM_TYPE_OWNERDRAW
			ownerdraw UI_NETGAMETYPE
			text "Game Mode:"
			rect 20 45 300 18
			textaligny 14
			textscale DK_TS
			forecolor DK_GOLD
			visible 1
		}

		itemDef {
			name maplist
			rect 20 75 200 200
			type ITEM_TYPE_LISTBOX
			style WINDOW_STYLE_EMPTY
			elementwidth 200
			elementheight 16
			textscale DK_TS_SMALL
			elementtype LISTBOX_TEXT
			feeder FEEDER_ALLMAPS
			border 1
			bordersize 2
			bordercolor .5 .1 .1 1
			forecolor DK_GOLD
			outlinecolor DK_SELECT
			visible 1
		}

		DK_LABEL( 240, 75, "Frag Limit" )
		DK_FIELD( 240, 95, "fraglimit", 4 )
		DK_LABEL( 240, 125, "Time Limit" )
		DK_FIELD( 240, 145, "timelimit", 4 )
		DK_LABEL( 240, 175, "Max Players" )
		DK_FIELD( 240, 195, "sv_maxclients", 2 )
		DK_YESNO( 240, 230, "Dedicated:", "ui_dedicated" )

		DK_BUTTON_MEDIUM( 280, 300, "Start!", uiScript StartServer )
	}

	// Sound
	menuDef {
		DK_PANEL( dk_sound )

		DK_SLIDER( 100, 95, 77, "Sound Effect Volume", "s_volume", 0.8, 0, 1 )
		DK_SLIDER( 100, 155, 137, "Music Volume", "s_musicvolume", 0.25, 0, 1 )
		DK_YESNO( 100, 200, "Sound:", "s_initsound" )
	}

	// Video
	menuDef {
		DK_PANEL( dk_video )

		DK_LABEL( 20, 35, "Driver" )
		DK_LABEL_BRIGHT( 120, 35, "OpenGL" )

		DK_MULTI( 20, 70, "Resolution:", "r_mode", { "Desktop" -2 "640x480" 3 "800x600" 4 "1024x768" 6 "1280x1024" 8 "1600x1200" 9 } )
		DK_SLIDER( 20, 122, 104, "Brightness", "r_gamma", 1, 0.5, 2 )
		DK_MULTI( 20, 152, "Texture Quality:", "r_picmip", { "Full" 0 "Half" 1 "Quarter" 2 "Eighth" 3 } )
		DK_SLIDER( 20, 202, 184, "Screen Size", "cg_viewsize", 100, 30, 100 )

		DK_YESNO( 240, 82, "Fullscreen:", "r_fullscreen" )
		DK_MULTI( 240, 102, "Shadows:", "r_dlightShadows", { "Off" 0 "On" 4 } )
		DK_YESNO( 240, 122, "Bullet Holes:", "cg_marks" )
		DK_YESNO( 240, 142, "Snow and Rain:", "cg_atmosphericEffects" )
		DK_YESNO( 240, 162, "Dynamic Lights:", "r_dynamiclight" )
		DK_MULTI( 240, 182, "Effects:", "fx_countScale", { "Low" 0.5 "High" 1 } )

		DK_BUTTON_LONG( 100, 300, "Apply Changes", exec "vid_restart" )
	}

	// Mouse
	menuDef {
		DK_PANEL( dk_mouse )

		DK_LABEL_BRIGHT( 20, 20, "Configure Mouse options:" )

		DK_MULTI( 20, 126, "Reverse Y-Axis:", "m_pitch", { "No" 0.022 "Yes" -0.022 } )
		DK_YESNO( 20, 146, "Mouse Look:", "cl_freelook" )
		DK_YESNO( 20, 166, "Smooth Mouse:", "m_filter" )

		DK_SLIDER( 20, 226, 208, "Mouse Speed", "sensitivity", 5, 1, 30 )

		DK_BIND( 20, 50, "Attack", "+attack" )
		DK_BIND( 20, 68, "Alt Attack", "+altattack" )
		DK_BIND( 20, 86, "Next Weapon", "weapnext" )
		DK_BIND( 20, 104, "Prev Weapon", "weapprev" )
	}

	// Keyboard: Daikatana's command list (dk_menu_keyboard.cpp), a page at a
	// time, its arrows turning the pages (one shown, the others hidden); each
	// page's items are its group
	menuDef {
		DK_PANEL( dk_keyboard )
		onOpen { hide kb1 ; hide kb2 ; hide kb3 ; show kb1 }

		DK_LABEL_BRIGHT( 24, 20, "Click or Enter to set, Backspace to clear" )

		// page 1: moving and looking
		DK_KEY_TITLE( kb1, 1, 24, 40, "Moving and looking  (1 of 3)" )
		DK_KEY_BIND( kb1, 1, 10, 64, "Forward", "+forward" )
		DK_KEY_BIND( kb1, 1, 10, 82, "Backward", "+back" )
		DK_KEY_BIND( kb1, 1, 10, 100, "Step Left", "+moveleft" )
		DK_KEY_BIND( kb1, 1, 10, 118, "Step Right", "+moveright" )
		DK_KEY_BIND( kb1, 1, 10, 136, "Jump", "+moveup" )
		DK_KEY_BIND( kb1, 1, 10, 154, "Crouch", "+movedown" )
		DK_KEY_BIND( kb1, 1, 10, 172, "Run", "+speed" )
		DK_KEY_BIND( kb1, 1, 10, 190, "Sidestep", "+strafe" )
		DK_KEY_BIND( kb1, 1, 210, 64, "Turn Left", "+left" )
		DK_KEY_BIND( kb1, 1, 210, 82, "Turn Right", "+right" )
		DK_KEY_BIND( kb1, 1, 210, 100, "Look Up", "+lookup" )
		DK_KEY_BIND( kb1, 1, 210, 118, "Look Down", "+lookdown" )
		DK_KEY_BIND( kb1, 1, 210, 136, "Center View", "centerview" )
		DK_KEY_BIND( kb1, 1, 210, 154, "MouseLook", "+mlook" )
		DK_KEY_BIND( kb1, 1, 210, 172, "Zoom", "+zoom" )
		DK_KEY_ARROW( kb1, 1, 290, 310, "ui/assets/dk/buttons/up_disabled", play DK_SND_HOVER )
		DK_KEY_ARROW( kb1, 1, 320, 310, "ui/assets/dk/buttons/down_off", hide kb1 ; hide kb2 ; hide kb3 ; show kb2 )

		// page 2: fighting and carrying
		DK_KEY_TITLE( kb2, 0, 24, 40, "Fighting and carrying  (2 of 3)" )
		DK_KEY_BIND( kb2, 0, 10, 64, "Attack", "+attack" )
		DK_KEY_BIND( kb2, 0, 10, 82, "Alt Attack", "+altattack" )
		DK_KEY_BIND( kb2, 0, 10, 100, "Use/Operate", "+use" )
		DK_KEY_BIND( kb2, 0, 10, 118, "Reload", "+reload" )
		DK_KEY_BIND( kb2, 0, 10, 136, "Next Weapon", "weapnext" )
		DK_KEY_BIND( kb2, 0, 10, 154, "Prev Weapon", "weapprev" )
		DK_KEY_BIND( kb2, 0, 10, 172, "Inventory", "inventory" )
		DK_KEY_BIND( kb2, 0, 10, 190, "Use Health", "invquick health" )
		DK_KEY_BIND( kb2, 0, 10, 208, "Quests", "quests" )
		DK_KEY_BIND( kb2, 0, 10, 226, "Status", "character" )
		DK_KEY_BIND( kb2, 0, 210, 64, "Belt 1", "belt 1" )
		DK_KEY_BIND( kb2, 0, 210, 82, "Belt 2", "belt 2" )
		DK_KEY_BIND( kb2, 0, 210, 100, "Belt 3", "belt 3" )
		DK_KEY_BIND( kb2, 0, 210, 118, "Belt 4", "belt 4" )
		DK_KEY_BIND( kb2, 0, 210, 136, "Belt 5", "belt 5" )
		DK_KEY_BIND( kb2, 0, 210, 154, "Belt 6", "belt 6" )
		DK_KEY_BIND( kb2, 0, 210, 172, "Belt 7", "belt 7" )
		DK_KEY_BIND( kb2, 0, 210, 190, "Belt 8", "belt 8" )
		DK_KEY_BIND( kb2, 0, 210, 208, "Belt 9", "belt 9" )
		DK_KEY_BIND( kb2, 0, 210, 226, "Belt 0", "belt 0" )
		DK_KEY_ARROW( kb2, 0, 290, 310, "ui/assets/dk/buttons/up_off", hide kb1 ; hide kb2 ; hide kb3 ; show kb1 )
		DK_KEY_ARROW( kb2, 0, 320, 310, "ui/assets/dk/buttons/down_off", hide kb1 ; hide kb2 ; hide kb3 ; show kb3 )

		// page 3: talking and the screen
		DK_KEY_TITLE( kb3, 0, 24, 40, "Talking and the screen  (3 of 3)" )
		DK_KEY_BIND( kb3, 0, 10, 64, "Talk", "messagemode" )
		DK_KEY_BIND( kb3, 0, 10, 82, "Talk to Team", "messagemode2" )
		DK_KEY_BIND( kb3, 0, 10, 100, "Scoreboard", "+scores" )
		DK_KEY_BIND( kb3, 0, 210, 64, "Screen Bigger", "sizeup" )
		DK_KEY_BIND( kb3, 0, 210, 82, "Screen Smaller", "sizedown" )
		DK_KEY_BIND( kb3, 0, 210, 100, "Screenshot", "screenshotJPEG" )
		DK_KEY_ARROW( kb3, 0, 290, 310, "ui/assets/dk/buttons/up_off", hide kb1 ; hide kb2 ; hide kb3 ; show kb2 )
		DK_KEY_ARROW( kb3, 0, 320, 310, "ui/assets/dk/buttons/down_disabled", play DK_SND_HOVER )

		DK_BUTTON_MEDIUM( 24, 310, "Defaults", exec "exec default.cfg" )
	}

	// Options
	menuDef {
		DK_PANEL( dk_options )

		DK_YESNO( 20, 15, "Always Run:", "cl_run" )
		DK_YESNO( 20, 35, "Weapon Visible:", "cg_drawGun" )
		DK_YESNO( 20, 55, "Auto-switch Weapons:", "cg_autoswitch" )
		DK_YESNO( 20, 75, "Target Names:", "cg_drawCrosshairNames" )
		DK_YESNO( 20, 95, "Show FPS:", "cg_drawFPS" )
		DK_YESNO( 20, 115, "Blood and Carnage:", "com_blood" )
		DK_YESNO( 20, 135, "Weapon Bobbing:", "cg_bobUp" )

		DK_MULTI( 220, 15, "Crosshair:", "cg_drawCrosshair", { "None" 0 "1" 1 "2" 2 "3" 3 "4" 4 } )
		DK_YESNO( 220, 35, "Simple Items:", "cg_simpleItems" )
		DK_YESNO( 220, 55, "Gibs:", "cg_gibs" )
	}

	// Credits
	menuDef {
		DK_PANEL( dk_credits )

		DK_LABEL_BRIGHT( 120, 30, "Daikatana" )
		DK_LABEL( 120, 50, "Ion Storm, 2000" )
		DK_LABEL_BRIGHT( 120, 90, "This port" )
		DK_LABEL( 120, 110, "Spearmint and mint-arena" )
		DK_LABEL( 120, 130, "Daikatana restoration project" )
		DK_LABEL( 120, 150, "id Software, Raven Software" )
	}

	// Quit
	menuDef {
		DK_PANEL( dk_quit )

		itemDef {
			rect 0 50 390 18
			text "What? You quit?"
			textalign ITEM_ALIGN_CENTER
			textalignx 195
			textaligny 14
			textscale DK_TS
			forecolor DK_BRIGHT
			decoration
			visible 1
		}
		itemDef {
			rect 0 65 390 18
			text "Don't you want to stick around"
			textalign ITEM_ALIGN_CENTER
			textalignx 195
			textaligny 14
			textscale DK_TS
			forecolor DK_BRIGHT
			decoration
			visible 1
		}
		itemDef {
			rect 0 80 390 18
			text "and kill some more?"
			textalign ITEM_ALIGN_CENTER
			textalignx 195
			textaligny 14
			textscale DK_TS
			forecolor DK_BRIGHT
			decoration
			visible 1
		}

		DK_BUTTON_SMALL( 110, 140, "Yes", uiScript Quit )
		DK_BUTTON_SMALL( 210, 140, "No", play "sounds/menus/no_001.wav" ; close dk_quit )
	}
}
