#include "ui/menudef.h"

// Daikatana's status bar (cl_scrn.cpp, SCR_DrawStats), at its places on a
// 640x480 screen kept at the bottom centre of wider ones: the bar and the
// player's face, and the armor, health, ammo and frags, each an icon, a
// label and a number, the number red when it runs low.

#define HUD_NUMBERS			"fonts/dk/mainnums" 20		// green digits
#define HUD_NUMBERS_LOW		"fonts/dk/mainnumsred" 20	// red digits
#define HUD_LABELS			"fonts/dk/statbar_font" 20
#define HUD_SCALE			.4167						// 20 pixel fonts at their own size
#define CENTER_FONT			"fonts/dk/scr_cent" 32		// centre prints and the scoreboard
#define CENTER_SCALE		.6667

// a picture of the bar
#define HUD_PIC( X, Y, W, H, SHADER ) \
	itemDef { \
		rect X Y W H \
		style WINDOW_STYLE_SHADER \
		background SHADER \
		forecolor 1 1 1 1 \
		decoration \
		visible 1 \
	}

// a label under an icon
#define HUD_LABEL( X, TEXT ) \
	itemDef { \
		rect X 458 80 16 \
		text TEXT \
		font HUD_LABELS \
		textscale HUD_SCALE \
		textaligny 16 \
		forecolor 1 1 1 1 \
		decoration \
		visible 1 \
	}

// a number centred on X, in FONT, shown when FLAGS say so
#define HUD_VALUE( X, OWNERDRAW, FONT, FLAGS ) \
	itemDef { \
		rect X 445 80 16 \
		ownerdraw OWNERDRAW \
		ownerdrawflag FLAGS \
		font FONT \
		textscale HUD_SCALE \
		forecolor 1 1 1 1 \
		decoration \
		visible 1 \
	}

// a window of the belt (Daikatana's weapon selector, draw_weapon_info, made
// Deus Ex's quick-use belt): the window, its highlight when KEY's item is the
// weapon in hand, the item turning in it and, in the box under it, its ammo
// or count. X, Y is the window's top left; IX, IY 8 right and below it, the
// item's box (its middle 28 below the top, as Daikatana's weapon's); CX, CY
// 40 and 50, the count's box.
#define BELT_SLOT( KEY, X, Y, IX, IY, CX, CY ) \
	HUD_PIC( X, Y, 128, 128, "pics/statusbar/weapn_win" ) \
	itemDef { \
		rect X Y 128 128 \
		ownerdraw CG_BELT_SELECTED \
		special KEY \
		background "pics/statusbar/selec_weapn" \
		forecolor 1 1 1 1 \
		decoration \
		visible 1 \
	} \
	itemDef { \
		rect IX IY 72 40 \
		ownerdraw CG_BELT_ITEM \
		special KEY \
		forecolor 1 1 1 1 \
		decoration \
		visible 1 \
	} \
	itemDef { \
		rect CX CY 40 16 \
		ownerdraw CG_BELT_COUNT \
		special KEY \
		font HUD_LABELS \
		textscale HUD_SCALE \
		forecolor 1 1 1 1 \
		decoration \
		visible 1 \
	}

// the key of a belt window, in its top left corner (X, Y the window's top
// left plus 22 and 18); after the windows, which overlap
#define BELT_KEY( LABEL, X, Y ) \
	itemDef { \
		rect X Y 12 12 \
		text LABEL \
		font HUD_LABELS \
		textscale HUD_SCALE \
		forecolor .81 .61 .39 1 \
		decoration \
		visible 1 \
	}

{
	menuDef {
		name "dk_hud"
		fullScreen MENU_FALSE
		visible MENU_TRUE
		rect 0 0 640 480
		screenPlacement PLACE_CENTER PLACE_BOTTOM

		// the bar: three pieces and, between the first two, the face
		HUD_PIC( 98, 352, 128, 128, "pics/statusbar/bottom_1" )
		HUD_PIC( 354, 352, 128, 128, "pics/statusbar/bottom_3" )
		HUD_PIC( 482, 352, 128, 128, "pics/statusbar/bottom_4" )
		itemDef {
			name "face"
			rect 226 352 128 128
			ownerdraw CG_PLAYER_FACE
			ownerDrawParam "hud/dk/face_%m_%c"	// see scripts/dk_hud.shader
			forecolor 1 1 1 1
			decoration
			visible 1
		}

		// icons
		HUD_PIC( 112, 416, 64, 64, "ui/assets/dk/hud/armoricon" )
		HUD_PIC( 202, 413, 64, 64, "ui/assets/dk/hud/healthicon" )
		HUD_PIC( 354, 414, 64, 64, "ui/assets/dk/hud/ammoicon" )
		HUD_PIC( 452, 416, 64, 64, "ui/assets/dk/hud/fragicon" )

		// labels
		HUD_LABEL( 139, "ARMOR" )
		HUD_LABEL( 216, "HEALTH" )
		HUD_LABEL( 382, "AMMO" )
		HUD_LABEL( 468, "FRAGS" )

		// numbers, centred on 163, 249, 402 and 492
		HUD_VALUE( 123, CG_PLAYER_ARMOR_VALUE, HUD_NUMBERS, CG_SHOW_ARMOROK )
		HUD_VALUE( 123, CG_PLAYER_ARMOR_VALUE, HUD_NUMBERS_LOW, CG_SHOW_ARMORLOW )
		HUD_VALUE( 209, CG_PLAYER_HEALTH, HUD_NUMBERS, CG_SHOW_HEALTHOK )
		HUD_VALUE( 209, CG_PLAYER_HEALTH, HUD_NUMBERS_LOW, CG_SHOW_HEALTHCRITICAL )
		HUD_VALUE( 362, CG_PLAYER_AMMO_VALUE, HUD_NUMBERS, CG_SHOW_AMMOOK )
		HUD_VALUE( 362, CG_PLAYER_AMMO_VALUE, HUD_NUMBERS_LOW, CG_SHOW_AMMOLOW )
		HUD_VALUE( 452, CG_PLAYER_SCORE, HUD_NUMBERS, 0 )
	}

	// the belt (g_inventory.c): keys 1 to 6 down the right, Daikatana's
	// weapon windows, 7 to 0 beside them; shown for cg_weaponSelectTime after
	// a change of weapon or a use of the belt, always with cg_drawBelt 1 and
	// on the inventory screen
	menuDef {
		name "weaponselect_menu"
		fullScreen MENU_FALSE
		visible MENU_FALSE
		rect 0 0 640 480
		screenPlacement PLACE_RIGHT PLACE_TOP

		BELT_SLOT( 1, 552, 16, 560, 24, 592, 66 )
		BELT_SLOT( 2, 552, 77, 560, 85, 592, 127 )
		BELT_SLOT( 3, 552, 138, 560, 146, 592, 188 )
		BELT_SLOT( 4, 552, 199, 560, 207, 592, 249 )
		BELT_SLOT( 5, 552, 260, 560, 268, 592, 310 )
		BELT_SLOT( 6, 552, 321, 560, 329, 592, 371 )
		BELT_SLOT( 7, 476, 16, 484, 24, 516, 66 )
		BELT_SLOT( 8, 476, 77, 484, 85, 516, 127 )
		BELT_SLOT( 9, 476, 138, 484, 146, 516, 188 )
		BELT_SLOT( 0, 476, 199, 484, 207, 516, 249 )

		BELT_KEY( "1", 574, 34 )
		BELT_KEY( "2", 574, 95 )
		BELT_KEY( "3", 574, 156 )
		BELT_KEY( "4", 574, 217 )
		BELT_KEY( "5", 574, 278 )
		BELT_KEY( "6", 574, 339 )
		BELT_KEY( "7", 498, 34 )
		BELT_KEY( "8", 498, 95 )
		BELT_KEY( "9", 498, 156 )
		BELT_KEY( "0", 498, 217 )
	}

	// centre prints (SCR_DrawCenterString): the centre font, a line at a
	// time centred from the top of the screen
	menuDef {
		name "centerprint_menu"
		fullScreen MENU_FALSE
		visible MENU_FALSE
		rect 0 0 640 480
		screenPlacement PLACE_CENTER PLACE_TOP

		itemDef {
			rect 0 10 640 300
			ownerdraw CG_CENTERPRINT
			font CENTER_FONT
			textscale CENTER_SCALE
			forecolor 1 1 1 1
			decoration
			visible 1
		}
	}

	// what use does to what's looked at (g_frob.c): "[E] Take Plasteel
	// Armor", red when there's no room for it in the inventory
	menuDef {
		name "frob_menu"
		fullScreen MENU_FALSE
		visible MENU_TRUE
		rect 0 0 640 480
		screenPlacement PLACE_CENTER PLACE_CENTER

		itemDef {
			rect 120 300 400 20
			ownerdraw CG_FROB_HINT
			ownerdrawflag CG_SHOW_FROB_ROOM
			ownerDrawParam "[%k] %a %n"
			font "fonts/dk/int_font_bright" 18
			textscale .375
			forecolor .81 .61 .39 1
			decoration
			visible 1
		}
		itemDef {
			rect 120 300 400 20
			ownerdraw CG_FROB_HINT
			ownerdrawflag CG_SHOW_FROB_NOROOM
			ownerDrawParam "[%k] %a %n"
			font "fonts/dk/int_font_bright" 18
			textscale .375
			forecolor .9 .2 .15 1
			decoration
			visible 1
		}
	}
}
