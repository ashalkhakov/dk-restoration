#include "ui/menudef.h"
#include "ui/dk_defs.h"

{
	// a dropped connection or a failed map
	menuDef {
		name error_popmenu
		fullScreen MENU_FALSE
		rect 140 160 360 160
		visible MENU_FALSE
		focusColor DK_BRIGHT
		style WINDOW_STYLE_FILLED
		backcolor 0 0 0 .85
		border 1
		borderSize 2
		borderColor .5 .1 .1 1
		onEsc { close error_popmenu ; open main }

		itemDef {
			rect 10 20 340 80
			type ITEM_TYPE_TEXT
			style WINDOW_STYLE_EMPTY
			cvar "com_errorMessage"
			autowrapped
			textalign ITEM_ALIGN_CENTER
			textalignx 170
			textaligny 14
			textscale DK_TS_SMALL
			forecolor DK_BRIGHT
			decoration
			visible 1
		}

		DK_BUTTON_SMALL( 149, 120, "OK", close error_popmenu ; open main )
	}
}
