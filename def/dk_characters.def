// What Daikatana's characters share; their model defs (char_*.def, made by
// tools/rig/autorig.py) inherit it.
//
// Footsteps, Doom 3's way: the "footstep <joint>" frame commands trace under
// the foot, and its material's surface type picks "snd_footstep_<type>", or
// "snd_footstep": sound shaders (sound/dk_characters.sndshd). Daikatana's
// glass steps were silent; here they're the plain ones.
entityDef character_base {
	"snd_bounce"			"dk_bodyhit"	// a ragdoll hitting something (Doom 3's)
	// moving: Daikatana's characters move like people, Hiro's run about 115
	// units a second (a unit is ~3.3 cm), its walk 45; Quake's 320 left the
	// feet sliding, 170 had the legs racing. One speed for all, near their
	// runs (Hiro's legs a little quicker, Mikiko's and Superfly's a little
	// slower); the legs play as fast as their "anim_speed" needs (bg_model.c)
	"run_speed"				"130"
	"walk_scale"			"0.35"

	// Doom 3's walk IK (bg_ik.c, Doom 3's player keys): the feet planted on the
	// floor under them; the rig's joints are Doom 3's. No ball joint: the ankle
	// stands for the foot
	"ik_numLegs"			"2"
	"ik_waist"				"Body"
	"ik_hip1"				"Lupleg"
	"ik_knee1"				"Lloleg"
	"ik_ankle1"				"Lankle_r"
	"ik_foot1"				"Lankle_r"
	"ik_hip2"				"Rupleg"
	"ik_knee2"				"Rloleg"
	"ik_ankle2"				"Rankle_r"
	"ik_foot2"				"Rankle_r"
	// the arms, Doom 3's reach IK (idIK_Reach): the hands on a ladder
	"ik_numArms"			"2"
	"ik_shoulder1"			"Luparm"
	"ik_elbow1"				"Lloarm"
	"ik_hand1"				"Lhand"
	"ik_shoulder2"			"Ruparm"
	"ik_elbow2"				"Rloarm"
	"ik_hand2"				"Rhand"
	"ik_footSize"			"4"

	"snd_footstep"				"dk_footstep"
	"snd_footstep_metal"			"dk_footstep_metal"
	"snd_footstep_stone"			"dk_footstep_stone"
	"snd_footstep_wood"			"dk_footstep_wood"
	"snd_footstep_liquid"			"dk_footstep_liquid"
	"snd_footstep_ice"			"dk_footstep_ice"
	"snd_footstep_snow"			"dk_footstep_snow"
	"snd_footstep_sand"			"dk_footstep_sand"
}

// Hiro in his gi (the intro, rigged from c_hiro_intr: def/rig_hirogi.def). His
// sword is a model of its own at the joint "sword" (autorig --props); in
// lksadb his left hand lets it go after frame 13, and it falls as a rigid
// body (the game's "drop" frame command)
entityDef model_hirogi_extra {
	"frame lksadb 13"		"drop sword"
}

// Usagi (the intro, rigged from c_usagi_intr: def/rig_usagi.def). His
// daikatana is a model of its own at the joint "sword" (autorig --props); in
// sambd he throws it, out of his hand by frame 18, and from frame 19 it flies
// on as a rigid body: the throw's speed and a push, high up over the volcano
// (shot 62's camera, after the cut, looks up and out where it comes down),
// then into the lava, 2.4 seconds after it's let go
entityDef model_usagi_extra {
	"frame sambd 19"		"drop sword 80 0 820"
}

// Inshiro (rigged from c_inshiro_intr: def/rig_inshiro.def). His daikatana is
// a model of its own at the joint "sword" (autorig --props); in sambd he
// throws it as Usagi does, out of his hand by frame 17, and from frame 19 it
// flies on as a rigid body with Usagi's push
entityDef model_inshiro_extra {
	"frame sambd 19"		"drop sword 80 0 820"
}
