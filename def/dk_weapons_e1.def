	"velocity"				"1800 0 0"
	"bounce"				"1.25"				// Daikatana speeds it up a bounce
	"max_bounces"			"3"					// it goes off on the third wall
	"detonate_on_world"		"0"
	"detonate_on_water"		"1"
	"fuse"					"4"
	"detonate_on_fuse"		"1"
	"def_damage"			"damage_ion"
