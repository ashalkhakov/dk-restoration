/*
===============================================================================

C4 VIZATERGO (slot 3): thrown charges that stick where they land, set off
with alt fire (Daikatana's button), or by themselves after a minute

===============================================================================
*/

entityDef weapon_c4viz {
	"player_anim_suffix"		"b"				// the player's animations with it, Daikatana's rifle (client.cpp)
	"spawnclass"			"item"
