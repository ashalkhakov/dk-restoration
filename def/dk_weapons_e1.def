	"inv_name"				"C4 Vizatergo"
	"model"					"models/e1/a_c4.md3"

	"weapon_slot"			"3"
	"bot_rating"			"0"				// bots can't set it off yet
	"fireRate"				"1.25"				// shoota, 25 frames
	"ammoRequired"			"1"
	"maxAmmo"				"20"
	"def_projectile"		"projectile_c4"
	"altfire"				"detonate"
	"altFireRate"			"1.35"				// btnpsh, 27 frames

	"model_world"			"models/e1/a_c4.md3"
	"model_world_frame"		"4"				// held in the hand: Daikatana draws frame 4 (cl_ents.cpp)
	"model_view"			"models/e1/w_c4.md3"
	"anim_fps"				"20"
	"anim_raise"			"ready"
	"anim_lower"			"away"
	"anim_idle"				"ambb 10"
	"anim_fire"				"shoota"
	"anim_altfire"			"btnpsh"
	"snd_fire"				"sounds/e1/we_c4shoota.wav"
	"snd_altfire"			"sounds/e1/we_c4beepa.wav sounds/e1/we_c4beepb.wav"
	"snd_raise"				"sounds/e1/we_c4ready.wav"

	"obituary"				"was made a mess of by"
}

entityDef projectile_c4 {
	"model"					"models/e1/we_c4prj.md3"
	"velocity"				"800 0 100"
	"gravity"				"1"
	"stick"					"1"
	"detonate_on_world"		"0"
	"detonate_on_actor"		"0"
	"fuse"					"60"
	"detonate_on_fuse"		"1"
