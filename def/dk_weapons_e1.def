// Daikatana's episode 1 weapons and ammo, as mint-arena entity defs (Doom 3
// style; see mint-arena's DEFS.md for the keys).
//
// Numbers are from Daikatana's Weapons.csv and dlls/weapons/*.cpp. Its
// weapons fire when their shooting animation allows (20 frames a second),
// so "fireRate" is that animation's length. Pickups are the a_*.md3 models,
// ammo the wa_*.md3 ones; the first person models are the w_*.md3 ones,
// whose frames are named by animation.

// what players start with
entityDef player {
	"weapon"				"weapon_disruptor"
}

/*
===============================================================================

DISRUPTOR GLOVE (slot 1): an electric punch

===============================================================================
*/

entityDef weapon_disruptor {
	"weapon_slot"			"1"
	"bot_rating"			"100"				// Weapons.csv
	"inv_name"				"Disruptor Glove"
	"melee"					"1"
	"fireRate"				"0.6"				// shoota, 12 frames
	"ammoRequired"			"0"
	"raiseTime"				"0.25"
	"lowerTime"				"0.2"
	"def_projectile"		"projectile_disruptor"

	"model_world"			"models/e1/a_tazer.md3"
	"model_world_frame"		"4"				// held in the hand: Daikatana draws frame 4 (cl_ents.cpp)
	"model_view"			"models/e1/w_tglove.md3"		// Daikatana's (w_disruptor is unused)
	"anim_fps"				"20"
	"anim_raise"			"ready"
	"anim_lower"			"away"
	"anim_idle"				"amba 10"
	"anim_fire"				"shoota"
	"snd_fire"				"sounds/e1/we_dgloveshoota.wav"
	"snd_raise"				"sounds/e1/we_dgloveready.wav"
	"flashColor"			"0.6 0.6 1"
	"flashRadius"			"0"

	"obituary"				"was humiliated by"
}

entityDef projectile_disruptor {
	"hitscan"				"1"
	"range"					"80"
	"def_damage"			"damage_disruptor"
	"fx_impact"				"dk/disruptor_hit"
	"fx_impact_flesh"		"dk/disruptor_hit"
	"snd_impact"			"sounds/e1/we_dglovehita.wav sounds/e1/we_dglovehitc.wav"
}

entityDef damage_disruptor {
	"damage"				"60"
}

/*
===============================================================================

ULTIMATE GAS HANDS (slot 1): the glove powered up; a punch takes anyone out
and throws them. In Daikatana's single player it runs out after two minutes,
in deathmatch it lasts until death (as here).

===============================================================================
*/

entityDef weapon_gashands {
	"spawnclass"			"item"
	"inv_weapon"			"weapon_gashands"
	"inv_name"				"Ultimate Gas Hands"
	"model"					"models/e1/a_gashand.md3"

	"weapon_slot"			"1"
	"bot_rating"			"700"				// a one-hit kill up close
	"melee"					"1"
	"fireRate"				"0.8"				// shootb, 16 frames
	"ammoRequired"			"0"
	"def_projectile"		"projectile_gashands"

	"model_world"			"models/e1/a_gashand.md3"
	"model_world_frame"		"-1"			// no held pose: the hands are the weapon
	"model_view"			"models/e1/w_gashand.md3"
	"anim_fps"				"20"
	"anim_raise"			"ready"
	"anim_lower"			"away"
	"anim_idle"				"amba 10"
	"anim_fire"				"shootb"
	"snd_fire"				"sounds/e1/we_dgloveshoota.wav"
	"snd_raise"				"sounds/e1/we_gasstart.wav"
	"snd_hum"				"sounds/e1/we_gasloopa.wav"
	"fx_muzzle"				"dk/muzzle_smoke"

	"obituary"				"was gassed by"
}

entityDef projectile_gashands {
	"hitscan"				"1"
	"range"					"100"
	"def_damage"			"damage_gashands"
	"fx_impact"				"dk/disruptor_hit"
	"fx_impact_flesh"		"dk/disruptor_hit"
	"snd_impact"			"sounds/e1/we_gasclang.wav sounds/e1/we_gasclanga.wav sounds/e1/we_gasclangc.wav"
}

entityDef damage_gashands {
	"damage"				"1000"				// Weapons.csv
}

