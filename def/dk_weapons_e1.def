}

/*
===============================================================================

SHOTCYCLER-6 (slot 4): a pull of the trigger fires all six barrels in a
row, ten pellets each

===============================================================================
*/

entityDef weapon_shotcycler {
	"player_anim_suffix"		"b"				// the player's animations with it, Daikatana's rifle (client.cpp)
	"spawnclass"			"item"
	"inv_weapon"			"weapon_shotcycler"
	"inv_ammo"				"30"
	"inv_name"				"Shotcycler-6"
	"model"					"models/e1/a_shot.md3"

	"weapon_slot"			"4"
	"bot_rating"			"400"				// Weapons.csv
	"burstCount"			"6"					// shots at frames 2, 8, ... 32 of "shoot" (shotcycler.cpp)
	"burstRate"				"0.27"				// 6 frames at 0.045
	"fireRate"				"1.44"				// the volley, to frame 34
	"clipSize"				"6"					// a volley, then it cycles: Doom 3's reload
	"reloadRate"			"1.93"				// frames 34 to 77
	"ammoRequired"			"1"
	"maxAmmo"				"100"
	"def_projectile"		"projectile_shotcycler"
	"numProjectiles"		"10"
	"spread"				"5"

	"model_world"			"models/e1/a_shot.md3"
	"model_world_frame"		"4"				// held in the hand: Daikatana draws frame 4 (cl_ents.cpp)
	"model_view"			"models/e1/w_shotcycler.md3"
	"anim_fps"				"22"
	"anim_raise"			"ready"
	"anim_lower"			"away"
	"anim_idle"				"ambc 10"
	"anim_fire"				"shoot 22 2 32"		// the volley...
	"anim_reload"			"shoot 22 34"		// ...and the cycling after it
	"snd_fire"				"sounds/e1/we_shotcyclershoota.wav sounds/e1/we_shotcyclershootb.wav"
	"snd_raise"				"sounds/e1/we_shotcyclerready.wav"
	"flashColor"			"1 0.8 0.4"
	"flashRadius"			"200"
	"fx_muzzle"				"dk/muzzle_smoke"

	"obituary"				"was double-barrelled by"
}

entityDef projectile_shotcycler {
	"hitscan"				"1"
	"range"					"1000"
	"def_damage"			"damage_shotcycler"
	"fx_impact"				"dk/bullet_hit"
	"mtr_detonate"			"gfx/damage/bullet_mrk"
	"decal_size"			"8"
}

entityDef damage_shotcycler {
	"damage"				"6"					// a tenth of 55 a pellet
}

entityDef ammo_shells {
	"spawnclass"			"item"
	"ammo_type"				"weapon_shotcycler"
	"inv_ammo"				"20"
	"inv_name"				"Shells"
	"model"					"models/e1/wa_shot6.md3"
	"snd_acquire"			"sounds/global/i_scyclerammo.wav"
}

