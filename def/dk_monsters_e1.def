// Daikatana's episode 1 monsters, as Doom 3 style monsters (mint-arena
// g_monster.c): a model def, the monster def (Daikatana's AIData.csv values
// at medium skill, but one hit kills them) and the damage defs of their
// attacks. What they do is their scripts' (script/ai/). These model defs are
// the md3s'; ./dk rig makes the rigged ones (def/rig_*.def, models/rigged/),
// which take their place with the same animation names, and ragdolls.

// the Froginator: a hopping melee frog, amphibious

entityDef model_froginator {
	"mesh"			"models/e1/m_frog.md3"
	"mins"			"-12 -12 -18"	// Daikatana's box, at the model's size (AIData.csv's / 0.65)
	"maxs"			"12 12 18"
	"anim amba"		"amba 10 loop"
	"anim ambb"		"ambb 10"
	"anim ataka"	"ataka 10"		// spit
	"anim atakb"	"atakb 10"		// bite
	"anim atakc"	"atakc 10"		// the leap
	"anim diea"		"diea 10"
	"anim hita"		"hita 10"
	"anim jumpa"	"jumpa 10"
	"anim runa"		"runa 15 loop"
	"anim swima"	"swima 10 loop"
	"anim walka"	"walka 10 loop"
}

entityDef monster_froginator {
	"spawnclass"	"monster"
	"model"			"model_froginator"
	"scriptobject"	"monster_froginator"
	"health"		"1"				// one hit: small, fast and hard to see (Daikatana's 30)
	"modelscale"	"0.65"
	"run_speed"		"220"
	"walk_speed"	"45"
	"turn_rate"		"540"
	"fov"			"270"
	"sight_range"	"1500"
	"melee_range"	"24"			// past its box: Daikatana's 60 from its middle
	"hop_min"		"200"			// a hop's length: how it gets about, crouching a moment between
	"hop_max"		"300"
	"hop_up"		"220"			// a hop's upward speed
	"hop_speed"		"500"			// across, at most
	"leap_range"	"350"			// nearer, it leaps at where you'll be
	"jump_up"		"270"			// a leap's upward speed
	"leap_speed"	"600"			// across, at most
	"leap_damage"	"damage_frog_leap"	// a leap that meets you
	"impact_speed"	"400"			// a leap into a wall at more hurts it (kills it, at one health)
	"impact_damage"	"6"				// per 100 u/s more
	"impact_bounce"	"0.5"
	"snd_sight"		"frog_sight"
	"snd_idle"		"frog_idle"
	"snd_attack"	"frog_attack"
	"snd_land"		"frog_land"
	"snd_impact"	"frog_impact"
}

entityDef damage_frog_leap {
	"damage"		"6"
	"damage_random"	"4"
	"push"			"250"			// knocks you back that fast
}
entityDef damage_frog_bite {
	"damage"		"4"
	"damage_random"	"2"
	"range"			"24"
}

// the Slaughter Skeet: a flying insect that crowds over you, darts in to bite, dodges your aim

entityDef model_slaughterskeet {
	"mesh"			"models/e1/m_skeeter.md3"
	"mins"			"-16 -16 0"		// Daikatana's box
	"maxs"			"16 16 8"
	"anim amba"		"amba 10 loop"
	"anim ambb"		"ambb 10"
	"anim ataka"	"ataka 10"
	"anim atakb"	"atakb 10"
	"anim diea"		"diea 10"
	"anim flya"		"flya 15 loop"
	"anim hita"		"hita 10"
	"anim speciala"	"speciala 10"	// hatching
}

entityDef monster_slaughterskeet {
	"spawnclass"	"monster"
	"model"			"model_slaughterskeet"
	"scriptobject"	"monster_slaughterskeet"
	"health"		"1"				// one hit (Daikatana's 50)
	"fly"			"1"
	"fly_speed"		"150"			// Daikatana's 200, slowed by skill (0.75 at medium)
	"fly_accel"		"900"			// how fast its thrust changes its velocity: nimble, it dodges
	"fly_offset"	"24"			// above what it flies at
	"fly_bob"		"6"
	"turn_rate"		"360"
	"fov"			"215"
	"sight_range"	"1800"
	"melee_range"	"16"
	"impact_speed"	"350"			// crashing harder kills it, a drone's way
	"impact_damage"	"4"
	"impact_bounce"	"0.6"
	"snd_sight"		"skeet_sight"
	"snd_idle"		"skeet_idle"
	"snd_attack"	"skeet_attack"
	"snd_fly"		"skeet_fly"
	"snd_impact"	"skeet_impact"
}

entityDef damage_skeet_bite {
	"damage"		"5"
	"damage_random"	"2"
	"range"			"16"
}

// the Crox: a robot crocodile, amphibious, that bites (crox.cpp): it runs at
// you on land and swims at you in water, and gives up on you when you're
// over 100 above or below it

entityDef model_crox {
	"mesh"			"models/e1/m_croco.md3"
	"mins"			"-16 -16 -16"	// AIData.csv
	"maxs"			"16 16 8"
	"anim amba"		"amba 10 loop"
	"anim ambb"		"ambb 10"
	"anim ataka"	"ataka 10"		// in water
	"anim atakb"	"atakb 10"
	"anim atakc"	"atakc 10"		// on land
	"anim atakd"	"atakd 10"
	"anim diea"		"diea 10"
	"anim dieb"		"dieb 10"
	"anim hita"		"hita 10"
	"anim hitb"		"hitb 10"
	"anim runa"		"runa 10 loop"
	"anim swima"	"swima 10 loop"
	"anim walka"	"walka 10 loop"
}

entityDef monster_crox {
	"spawnclass"	"monster"
	"model"			"model_crox"
	"scriptobject"	"monster_crox"
	"mins"			"-24 -24 -18"	// the box it moves with: its body's middle, Daikatana's (its tail and
	"maxs"			"24 24 8"		// head reach past it; shots meet its rig's hitboxes)
	"health"		"150"
	"run_speed"		"175"
	"walk_speed"	"50"
	"turn_rate"		"250"			// 25 a tenth of a second
	"fov"			"270"
	"sight_range"	"1300"
	"melee_hitbox"	"Head"			// it bites with its jaws: the front of its rig's head box
	"melee_range"	"32"			// its jaws this near you, it lunges
	"pain_chance"	"0.2"
	"snd_sight"		"crox_sight"
	"snd_idle"		"crox_idle"
	"snd_swim"		"crox_swim"
}

entityDef damage_crox_bite {
	"damage"		"15"
	"damage_random"	"20"
	"range"			"12"			// from its jaws, as they close (the bite's frame)
}

// the Protopod: a pod that hatches a slaughter skeet (protopod.cpp) when it
// sees you near, then lies open

entityDef model_protopod {
	"mesh"			"models/e1/m_proto.md3"
	"mins"			"-3.6 -3.6 0"	// Daikatana's box, at the model's size (AIData.csv's / 2.5)
	"maxs"			"3.6 3.6 4"
	"anim amba"		"amba 10 loop"
	"anim hatcha"	"hatcha 10"
}

entityDef monster_protopod {
	"spawnclass"	"monster"
	"model"			"model_protopod"
	"scriptobject"	"monster_protopod"
	"health"		"50"
	"modelscale"	"2.5"
	"run_speed"		"0"
	"turn_rate"		"0"
	"fov"			"360"
	"sight_range"	"1000"
	"hatch_range"	"200"			// it hatches when it sees you this near
	"maybe_range"	"512"			// or by chance this near
	"hatch_monster"	"monster_slaughterskeet"
	"snd_idle"		"protopod_idle"
}

// the Skinny Worker: a mine worker, harmless, who runs from you when hurt
// and cowers (skinnyworker.cpp)

entityDef model_skinnyworker {
	"mesh"			"models/e1/m_mwskny.md3"
	"mins"			"-12 -12 -24"	// AIData.csv
	"maxs"			"12 12 34"
	"anim amba"		"amba 10 loop"
	"anim ambb"		"ambb 10"
	"anim runa"		"runa 10 loop"
	"anim walka"	"walka 10 loop"
	"anim damba"	"damba 10 loop"	// looking out
	"anim dambb"	"dambb 10"
	"anim gamba"	"gamba 10 loop"	// cowering
	"anim gambc"	"gambc 10 loop"
	"anim diea"		"diea 10"
	"anim dieb"		"dieb 10"
}

entityDef monster_skinnyworker {
	"spawnclass"	"monster"
	"model"			"model_skinnyworker"
	"scriptobject"	"monster_skinnyworker"
	"health"		"25"
	"run_speed"		"150"
	"walk_speed"	"35"
	"turn_rate"		"600"			// 60 a tenth of a second
	"fov"			"220"
	"sight_range"	"1000"
	"snd_flee"		"worker_flee"
}

// the Cambot: a flying security camera (cambot.cpp). It never attacks: it
// patrols its monster_path_corners, and when it sees you (75 degrees either
// side of where it looks) it sounds the alarm, and every monster within
// 1024 that hears it comes for you; then it follows you, 72 to 192 away and
// 72 above. A robot: it blows up.

entityDef model_cambot {
	"mesh"			"models/e1/m_cambot.md3"
	"mins"			"-24 -24 -24"	// AIData.csv
	"maxs"			"24 24 24"
	"anim amba"		"amba 10 loop"
	"anim flya"		"flya 10 loop"
	"anim diea"		"diea 10"
}

entityDef monster_cambot {
	"spawnclass"	"monster"
	"model"			"model_cambot"
	"scriptobject"	"monster_cambot"
	"health"		"80"
	"fly"			"1"
	"fly_speed"		"250"
	"walk_speed"	"50"			// on its patrol
	"fly_accel"		"400"
	"fly_offset"	"72"			// above you
	"fly_bob"		"8"
	"fly_jitter"	"24"			// its engine doesn't hold steady: its lift wavers, it sputters
	"fly_wobble"	"5"				// and it rocks, degrees
	"turn_rate"		"90"
	"fov"			"150"			// it sees 75 degrees either side (CAMBOT_IsVisible)
	"sight_range"	"3000"
	"alarm_range"	"1024"
	"near"			"72"			// it keeps this far away
	"far"			"192"			// and no farther
	"snd_alarm"		"cambot_alarm"
	"snd_fly"		"cambot_hum"
	"snd_death"		"robot_explode"
}

// the Rockgat: a chaingun turret in the rock (rockgat.cpp). Lowered until
// it sees you within its "range" (Daikatana's 512), it rises, and a second
// later fires at you about eight bullets a second, turning to you, while it
// sees you no more than 20 degrees above or below it. A machine: it blows up.

entityDef model_rockgat {
	"mesh"			"models/e1/a1_rockgun.md3"
	"mins"			"-16 -16 -16"	// AIData.csv
	"maxs"			"16 16 16"
	"anim idle"		"0 1 1"			// lowered in the rock, its first frame, until it sees you
	"anim up"		"up 10"			// rising out of the rock
}

entityDef monster_rockgat {
	"spawnclass"	"monster"
	"model"			"model_rockgat"
	"scriptobject"	"monster_rockgat"
	"health"		"500"
	"run_speed"		"0"
	"turn_rate"		"200"			// 20 a tenth of a second
	"fov"			"360"
	"sight_range"	"1024"
	"range"			"512"			// it fires within this
	"fire_rate"		"0.13"			// seconds a bullet, and up to 0.03 more
	"def_weapon"	"weapon_monster_rockgat"
	"muzzle"		"16 0 4"		// its barrel, forward, left, up
	"snd_fire"		"rockgat_fire"
	"snd_up"		"rockgat_up"
	"snd_death"		"robot_explode"
}

// monsters' weapons: weapon defs no player has, at slot 99 so that the
// players' weapons keep their numbers
entityDef weapon_monster_rockgat {
	"weapon_slot"			"99"
	"def_projectile"		"projectile_rockgat"
	"obituary"				"was gunned down by a rockgat"
}

entityDef projectile_rockgat {
	"hitscan"				"1"
	"range"					"512"
	"def_damage"			"damage_rockgat"
	"fx_impact"				"dk/bullet_hit"
	"fx_impact_flesh"		"dk/blood"
}

entityDef damage_rockgat {
	"damage"				"2"				// Daikatana's basedmg 1 + rnddmg 1
}

// the Thunderskeet: a great flying skeet, episode 1's boss among them
// (thunderskeet.cpp). It flies at you and keeps 96 above you; within 600
// it hovers, faces you, charges (two green flares) and fires two slow
// yellow balls of lightning that bounce about until they touch someone,
// then darts at you or flies off, and fires again. A machine: it blows up.

entityDef model_thunderskeet {
	"mesh"			"models/e1/m_tskeet.md3"
	"mins"			"-37 -37 0"		// AIData.csv
	"maxs"			"37 37 90"
	"anim amba"		"amba 10 loop"
	"anim ataka"	"ataka 10"
	"anim flya"		"flya 10 loop"
	"anim hita"		"hita 10"
	"anim hitb"		"hitb 10"
	"anim diea"		"diea 10"
}

entityDef monster_thunderskeet {
	"spawnclass"	"monster"
	"model"			"model_thunderskeet"
	"scriptobject"	"monster_thunderskeet"
	"health"		"600"
	"fly"			"1"
	"fly_speed"		"350"
	"fly_accel"		"500"
	"fly_offset"	"96"			// above you
	"fly_bob"		"8"
	"turn_rate"		"180"
	"fov"			"215"
	"sight_range"	"2000"
	"attack_range"	"600"
	"dart_speed"	"525"			// x1.5, at you after firing
	"pain_chance"	"0.1"
	"def_weapon"	"weapon_monster_thunderskeet"
	"muzzle"		"0 0 -40"		// under it
	"snd_sight"		"tskeet_sight"
	"snd_idle"		"tskeet_idle"
	"snd_fly"		"tskeet_fly"
	"snd_death"		"robot_explode"
}

entityDef weapon_monster_thunderskeet {
	"weapon_slot"			"99"
	"def_projectile"		"projectile_thunderjiz"
	"obituary"				"was fried by a thunderskeet"
}

// Daikatana's ThunderSpray: slow (128 to 192), bouncing about for 15
// seconds, going off on whoever it touches, 40 within 256
entityDef projectile_thunderjiz {
	"velocity"				"160 0 0"
	"bounce"				"1"
	"max_bounces"			"20"
	"detonate_on_world"		"0"
	"detonate_on_actor"		"1"
	"fuse"					"15"
	"detonate_on_fuse"		"1"
	"def_damage"			"damage_thunderjiz"
	"def_splash_damage"		"damage_thunderjiz_splash"
	"light_color"			"0.15 0.95 0.35"
	"light_radius"			"400"
	"fx_fly"				"dk/thunderjiz_fly"
	"fx_fly_interval"		"0.05"
	"fx_detonate"			"dk/thunderjiz_explode"
	"snd_explode"			"sounds/global/e_explodeb.wav"
	"snd_fly"				"sounds/global/e_warploopb.wav"
}

entityDef damage_thunderjiz {
	"damage"				"15"			// AIData.csv's 10 + up to 10
}

entityDef damage_thunderjiz_splash {
	"damage"				"40"
	"radius"				"256"
}

// what the monsters' model defs keep when a rigged one takes the md3's place
// (bg_model.c BG_ModelKey): their effects and lights

// its lamp (ai_weapons.cpp light_spawn, light_think): at its hardpoint
// (hr_light), a yellow flare and light, its searchlight 45 down, panning
// -45 to 64 degrees about where it faces, 80 a second, 600 long; seeing
// you, on you and red, its flare red (e_sflred). Its beam through the air
// is ours (Daikatana's renderer drew its spot light's)
entityDef model_cambot_extra {
	"surface"		"metal"
	"fx_death"		"dk/explosion"
	"light_radius"	"600"
	"light_color"	"1 0.95 0.55"
	"light_alarm_color"	"1 0.15 0.15"
	"light_joint"	"hr_light"
	"light_cone"	"25"
	"light_sweep"	"-45 64 80"		// from, to (degrees of yaw), degrees a second
	"light_pitch"	"45"			// down
	"light_glow"	"96"			// the light about its flare (Daikatana's 225, dimmer)
	"light_flare"	"dkfx/cambotf"
	"light_flare_alarm"	"dkfx/sflred"
	"light_flare_size"	"40"
	"light_beam"	"dkfx/lampbeam"
	"light_beam_length"	"600"
	"light_beam_alpha"	"0.35"
}

entityDef model_rockgat_extra {
	"surface"		"metal"
	"fx_death"		"dk/explosion"
	"fx_muzzle"		"dk/rockgat_flash"
	"light_ambient"	"64 64 64"		// in the rock, where the light grid is black
}

entityDef model_thunderskeet_extra {
	"surface"		"metal"
	"fx_death"		"dk/explosion"
	"fx_attack"		"dk/thunderskeet_charge"
	"fx_muzzle"		"dk/thunderskeet_fire"
}
