	"anim walka"		"walka 10 loop"
	"anim_speed runa"	"25"	// over the ground, from its feet
	"anim_speed walka"	"14"	// over the ground, from its feet

	"hitbox Body"	"-8.3 -5.8 -4.2 10.9 6.3 6.9 torso"
	"hitbox Head"	"-4.2 -1.2 -1.1 5.8 6.3 8.4 head"
