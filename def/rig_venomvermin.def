// made by tools/rig/creature_rig.py from models/e1/m_vermin.md3: the rigged model, in place of the md3's
entityDef model_venomvermin {
	"mesh"			"models/rigged/vermin.iqm"
	"mins"			"-38 -38 -7"	// the box it moves with: all but its wings, idling
