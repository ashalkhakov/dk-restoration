// made by tools/rig/creature_rig.py from models/e1/m_proto.md3: the rigged model, in place of the md3's
entityDef model_protopod {
	"mesh"			"models/rigged/proto.iqm"
	"mins"			"-5 -5 -0"	// the box it moves with: all but its wings, idling
	"maxs"			"5 5 10"
	"hit_mins"		"-5 -5 -0"	// the box shots meet: all of it, whichever way it faces
	"hit_maxs"		"5 5 10"
	"surface"		"metal"	// Doom 3's surface type: its hits spark, no blood

	"anim amba"		"amba 10 loop"
	"anim hatcha"		"hatcha 10"
	"anim perch"		"0 1 1 loop"	// landed, its wings raised: the frame they reach out least

	"hitbox Body"	"-3.0 -1.7 -3.7 5.6 1.8 2.9 torso"
	"hitbox Head"	"-0.6 -0.9 -2.3 2.7 1.7 3.4 head"
	"hitbox Rfore1"	"0.8 -2.9 -0.4 1.7 -0.5 2.2 legs"
	"hitbox Rhind1"	"-0.6 -2.4 -1.0 4.5 3.1 1.1 legs"
	"hitbox Rhind2"	"-3.8 -4.0 -0.5 2.2 1.3 4.4 legs"
	"hitbox Rwing1"	"0.1 -2.3 -4.5 3.8 2.3 2.5 legs"
	"hitbox Rwing2"	"-1.7 -2.1 -2.4 2.3 2.2 2.2 legs"
	"hitbox Rwingb1"	"-4.2 1.8 -1.8 0.9 4.6 3.4 legs"
	"hitbox Rwingc1"	"0.8 -0.2 -0.8 3.7 0.5 1.6 legs"
	"hitbox Rwingc2"	"-3.0 -2.6 -0.8 -0.5 -0.7 2.6 legs"
	"hitbox Tail1"	"0.7 -0.1 -2.3 3.2 2.0 3.0 torso"
	"hitbox Tailb1"	"-0.1 -0.5 -3.5 3.1 2.1 0.9 torso"

	"damage_scale head"	"2"
	"damage_scale legs"	"0.75"

	"ragdoll"		"monster_protopod"	// af/monster_protopod.af, Doom 3's articulated figure
}
