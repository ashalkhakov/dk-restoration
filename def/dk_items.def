}

// armor: suits, worn one at a time from the inventory (g_inventory.c). Each
// has its points ("inv_armor") and takes its share of the damage
// ("armor_absorb"), Daikatana's (artifacts.cpp); a suit keeps what's left of
// its points when taken off or dropped. The model is the episode's.

entityDef item_plasteel_armor {
	"spawnclass"	"item"
	"inv_armor"		"200"
	"armor_absorb"	"0.75"
	"inv_size"		"2 3"
	"inv_name"		"Plasteel Armor"
	"inv_desc"		"Light armor plates. Takes three quarters of the damage."
	"model"			"models/e1/a1_ar1.md3"
	"icon"			"icons/iconr_yellow"
	"snd_acquire"	"sounds/global/armorpickup1.wav"
}

entityDef item_chromatic_armor {
	"spawnclass"	"item"
