// artifacts (artifacts.cpp): carried, used from the inventory or the belt.
// A boost raises one of Daikatana's five stats to its top level for 30
// seconds (com_CalcBoosts): power x2.5 damage, attack x3 firing and x2.5
// projectile speed, speed x2 running, acro x1.75 jumping (x2.5 in
// deathmatch) and half the falling damage, vita +250 to health's limit and
// 75 health at once. The wraith orb hides you from monsters for a minute;
// the skull of invincibility takes no damage for 30 seconds.

entityDef item_wraithorb {
	"spawnclass"	"item"
	"inv_powerup"	"invis"
	"time"			"60"
	"inv_name"		"Wraith Orb"
	"inv_desc"		"For a minute you're all but invisible, and monsters can't see you."
	"model"			"models/global/a_wraithorb.md3"
	"icon"			"icons/invis"
	"snd_acquire"	"sounds/artifacts/wraithorbpickup.wav"
	"sounds"		"sounds/artifacts/wraithorbwait.wav"
}

entityDef item_power_boost {
