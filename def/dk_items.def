// the campaign's inventory items (Doom 3's "inv_item"): kept, not used up on
// pickup; "inv_max" the most one carries. Daikatana's keys open what names
// them as its "keyname" (a func_button, a trigger_changelevel...).

entityDef item_savegem {
	"spawnclass"	"item"
	"inv_item"		"1"
	"inv_name"		"Save Gem"
	"inv_max"		"3"			// Daikatana's: no more than three
	"model"			"models/global/a_savegem.md3"
	"snd_acquire"	"sounds/artifacts/savegem_pickup.wav"
	"nophysics"		"1"
}

entityDef item_key_base {
	"spawnclass"	"item"
	"inv_item"		"1"
	"inv_max"		"1"
	"snd_acquire"	"sounds/global/a_specialitem.wav"
	"nophysics"		"1"
}

