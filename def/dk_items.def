// Daikatana's pickups, as mint-arena entity defs (Doom 3 style): what each
// gives ("inv_*", see bg_defs.c), its look and its sounds. The converter
// keeps the classnames; where the model changes with the episode (armor), the
// map's "model" key gives the episode's. Physics: items are rigid bodies
// colliding as hulls of their models; "mass", "density", "bouncyness",
// "friction", "nophysics".

// health

entityDef item_health_25 {
	"spawnclass"	"item"
	"inv_health"	"25"
	"inv_name"		"Health"
	"inv_desc"		"Heals 25."
	"model"			"models/e1/a1_hlth.md3"
	"icon"			"icons/iconh_yellow"
	"snd_acquire"	"sounds/global/a_hpick.wav"
}

entityDef item_health_50 {
	"spawnclass"	"item"
	"inv_health"	"50"
	"inv_name"		"Large Health"
	"inv_desc"		"Heals 50."
	"model"			"models/e1/a1_hlth2.md3"
	"icon"			"icons/iconh_red"
	"snd_acquire"	"sounds/global/a_hpick.wav"
}

entityDef item_goldensoul {
	"spawnclass"	"item"
