	"inv_name"		"Chromatic Armor"
	"inv_desc"		"A chromed suit. Takes half of the damage."
	"model"			"models/e1/a1_ar2.md3"
	"icon"			"icons/iconr_red"
	"snd_acquire"	"sounds/global/armorpickup2.wav"
}

