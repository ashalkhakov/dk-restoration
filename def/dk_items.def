// Daikatana's pickups, as mint-arena entity defs (Doom 3 style).
//
// Each one inherits the Quake 3 item that plays its role in deathmatch and
// gives it Daikatana's name and look. The converter keeps the classnames;
// where the model changes with the episode (armor), the map's "model" key
// gives the episode's. Physics: items are rigid bodies colliding as hulls of
// their models; "mass", "density", "bouncyness", "friction", "nophysics".

// health

entityDef item_health_25 {
	"inherit"		"item_health"
	"inv_name"		"Health"
}

entityDef item_health_50 {
	"inherit"		"item_health_large"
	"inv_name"		"Health"
}

entityDef item_goldensoul {
	"inherit"		"item_health_mega"
	"inv_name"		"Golden Soul"
	"model2"		""
}

