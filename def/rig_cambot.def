// made by tools/rig/creature_rig.py from models/e1/m_cambot.md3: the rigged model, in place of the md3's
entityDef model_cambot {
	"mesh"			"models/rigged/cambot.iqm"
	"mins"			"-49 -49 -38"	// the box it moves with: all but its wings, idling
	"maxs"			"49 49 17"
	"hit_mins"		"-49 -49 -38"	// the box shots meet: all of it, whichever way it faces
	"hit_maxs"		"49 49 17"
	"surface"		"metal"	// Doom 3's surface type: its hits spark, no blood

	"anim amba"		"amba 10 loop"
	"anim diea"		"diea 10"
	"anim flya"		"flya 10 loop"

	"hitbox Body"	"-11.1 -21.1 -43.5 23.2 21.5 31.3 torso"
	"hitbox Tail1"	"-25.3 -15.5 -21.1 50.3 17.7 9.4 torso"
	"hitbox Tail2"	"-9.4 -2.6 -2.5 4.9 7.6 6.8 torso"

	"damage_scale head"	"2"
	"damage_scale legs"	"0.75"

	"ragdoll"		"monster_cambot"	// af/monster_cambot.af, Doom 3's articulated figure
}
