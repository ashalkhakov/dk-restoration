// e1m1a's entities changed by hand (tools/maps/ent_overrides.py)

// Toshiro's body: Daikatana's deadtoshiro deco (cin_toshiro.md3, a still
// model) out, his rigged character in, where the deco was, 1.25 times the
// cinematic model's size as Daikatana's map draws him. The deco's origin is
// at the body; a character's is 24 (30 at his size) over its floor, its
// dead lie on: his is the deco's 30 higher. A ragdoll asleep ("nodrop",
// Doom 3's) in the same pose till he's hit (coffin, the frame the deco's
// mesh is)
{
"_match classname" "misc_gamemodel"
"_match model" "models/e1/cin_toshiro.md3"
"_delete" "1"
}
{
"classname" "misc_character"
"model" "model_toshiro"
"anim" "coffin"
"ragdoll" "1"
"nodrop" "1"
"modelscale" "1.25"
"origin" "1779 -2590 558"
"angle" "0"
}

// the dead workers: Daikatana's deadguy decos (m_dead.md3, still, one of its
// ten death poses each by "frame", 1.5 times the size) out, the rigged
// m_dead character in (its poses dead000 to dead009, an animation each), a
// ragdoll limp from the start in that pose, settling into its coffin (a hull
// for each board: below); each just over where it comes to rest (Daikatana's
// decos were spawned higher, and fell)
{
"_match classname" "func_physics"
"_match model" "models/e1/m_dead.md3"
"_match origin" "1602 -2695 552"
"_delete" "1"
}
{
"classname" "misc_character"
"model" "model_dead"
"anim" "dead004"
"ragdoll" "1"
"modelscale" "1.5"
"origin" "1602 -2695 546"
}
{
"_match classname" "func_physics"
"_match model" "models/e1/m_dead.md3"
"_match origin" "1473 -2716 536"
"_delete" "1"
}
{
"classname" "misc_character"
"model" "model_dead"
"anim" "dead008"
"ragdoll" "1"
"modelscale" "1.5"
"origin" "1473 -2716 533"
}
{
"_match classname" "func_physics"
"_match model" "models/e1/m_dead.md3"
"_match origin" "1731 -2430 540"
"_delete" "1"
}
{
"classname" "misc_character"
"model" "model_dead"
"anim" "dead001"
"ragdoll" "1"
"modelscale" "1.5"
"angle" "135"
"origin" "1731 -2430 549"
}

// the dump truck: Daikatana's deathtruck deco (d1_deathtruck.md3, a still
// model) out, the vehicle in (g_vehicle.c, def/vehicle_deathtruck.def), where
// the deco was, facing as it did: USE gets in and drives it. Daikatana's
// size here (e1m4a's is 1.5): bigger, it can't get under the bridge's truss
{
"_match classname" "misc_gamemodel"
"_match model" "models/e1/d1_deathtruck.md3"
"_delete" "1"
}
{
"classname" "vehicle_deathtruck"
"targetname" "deathtruck"
"origin" "1592 -2784 1056"
"angle" "180"
}

// the coffins (d1_coffin2.md3: broken open, its boards scattered): a hull for
// each board ("hull_pieces"), not convex pieces cut from the whole, which
// bridged the gaps between the boards and stood out past them
{
"_match classname" "func_physics"
"_match model" "models/e1/d1_coffin2.md3"
"_match origin" "1513 -2720 560"
"hull_pieces" "1"
}
{
"_match classname" "func_physics"
"_match model" "models/e1/d1_coffin2.md3"
"_match origin" "1619 -2694 560"
"hull_pieces" "1"
}
{
"_match classname" "func_physics"
"_match model" "models/e1/d1_coffin2.md3"
