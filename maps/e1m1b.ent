// e1m1b's entities changed by hand (tools/maps/ent_overrides.py)

// the episode's quest (def/dk_quests.def): the boss fight ("doitall", set
// off by a cambot's alarm or death, or the bridge) spawns the thunderskeet
// ("tskeetspawn"), and the swamp entrance is missed; killed ("tskeetdead"),
// it opens the way, and the Sewer System is the way
{
"classname" "target_setobjective"
"targetname" "tskeetspawn"
"quest" "quest_e1_fortress"
"objective" "1"
"state" "failed"
"only_if" "incomplete"
"origin" "-416 640 1660"
}
{
"classname" "target_setobjective"
"targetname" "tskeetdead"
"quest" "quest_e1_fortress"
"objective" "2"
"visible" "1"
"origin" "-416 640 1680"
}

// the laser screen across the way to the bridge: crossing its tripwire
// sets it spinning and the alarm going ("warnlight"); its hub can be shot
// down first, and the tripwire goes with it
{
"_match classname" "trigger_multiple"
"_match model" "*35"
"targetname" "screen_trip"
}
{
"_match classname" "func_rotating"
"_match targetname" "warnlight"
"health" "30"
"killtarget" "screen_trip"
"breaksound" "sounds/global/e_metalbreaksa.wav"
}
