// Daikatana's footsteps, Doom 3 sound shaders: one of the files at random.
// Characters name them by surface type (def/dk_characters.def:
// "snd_footstep_<type>"). Daikatana plays them at full volume, normal
// attenuation (p_client.cpp, cl_fx.cpp); distances are Doom 3's, metres.

dk_footstep
{
	minDistance	6.5
	maxDistance	16.5
	volume		1
	no_dups
	sounds/global/p_stp1.wav
	sounds/global/p_stp2.wav
	sounds/global/p_stp3.wav
	sounds/global/p_stp4.wav
}

