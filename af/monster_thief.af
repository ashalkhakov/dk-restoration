// made by tools/rig/autorig.py: thief's ragdoll, Doom 3's articulated figure
// (made in the model's bind pose; joint() and bone*() name the IQM's joints)
articulatedFigure monster_thief {
	settings {
		model "model_thief"
		friction 0.01, 0.01, 0.8, 0.5
		suspendSpeed 20, 30, 40, 60
		noMoveTime 1
		noMoveTranslation 10
		noMoveRotation 10
		minMoveTime -1
		maxMoveTime -1
		totalMass -1
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "waist" {
		joint "origin"
		mod orientation
		model box( ( -1.97, -2.41, -3.13 ), ( 1.97, 2.41, 3.13 ) )
		origin ( 1.05, -1.46, -9.98 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "chest" {
