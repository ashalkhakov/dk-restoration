// made by tools/rig/creature_rig.py: the slaughterskeet's ragdoll, Doom 3's articulated figure
// (made in the model's bind pose; joint() names the IQM's joints)
articulatedFigure monster_slaughterskeet {
	settings {
		model "model_slaughterskeet"
		friction 0.01, 0.01, 0.8, 0.5
		suspendSpeed 20, 30, 40, 60
		noMoveTime 1
		noMoveTranslation 10
		noMoveRotation 10
		minMoveTime -1
		maxMoveTime -1
		totalMass -1
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "body" {
		joint "origin"
		mod orientation
		model box( ( -3.61, -1.43, -2.59 ), ( 3.61, 1.43, 2.59 ) )
