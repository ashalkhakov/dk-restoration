// made by tools/rig/autorig.py: ninja's ragdoll, Doom 3's articulated figure
// (made in the model's bind pose; joint() and bone*() name the IQM's joints)
articulatedFigure monster_ninja {
	settings {
		model "model_ninja"
		friction 0.01, 0.01, 0.8, 0.5
		suspendSpeed 20, 30, 40, 60
		noMoveTime 1
		noMoveTranslation 10
		noMoveRotation 10
		minMoveTime -1
		maxMoveTime -1
		totalMass -1
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

