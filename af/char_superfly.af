// made by tools/rig/autorig.py: superfly's ragdoll, Doom 3's articulated figure
// (made in the model's bind pose; joint() and bone*() name the IQM's joints)
articulatedFigure char_superfly {
	settings {
		model "model_superfly"
		friction 0.01, 0.01, 0.8, 0.5
		suspendSpeed 20, 30, 40, 60
		noMoveTime 1
		noMoveTranslation 10
