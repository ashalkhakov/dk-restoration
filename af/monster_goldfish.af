// made by tools/rig/creature_rig.py: the goldfish's ragdoll, Doom 3's articulated figure
// (made in the model's bind pose; joint() names the IQM's joints)
articulatedFigure monster_goldfish {
	settings {
		model "model_goldfish"
		friction 0.01, 0.01, 0.8, 0.5
		suspendSpeed 20, 30, 40, 60
		noMoveTime 1
		noMoveTranslation 10
		noMoveRotation 10
		minMoveTime -1
		maxMoveTime -1
		totalMass -1
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "body" {
		joint "origin"
		mod orientation
		model box( ( -6.63, -2.11, -3.80 ), ( 6.63, 2.11, 3.80 ) )
		origin ( 3.93, 0.17, 0.05 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "tail1" {
		joint "Tail1"
		mod orientation
		model box( ( -2.88, -0.77, -3.59 ), ( 2.88, 0.77, 3.59 ) )
		origin ( -8.20, -0.02, -0.29 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	universalJoint "Tail1" {
		body1 "tail1"
		body2 "body"
		anchor joint( "Tail1" )
		shafts ( -1.00, 0.04, 0.04 ), ( 1.00, -0.04, -0.04 )
		friction 0.20
		coneLimit ( -1.00, 0.04, 0.04 ), 80
	}

}
