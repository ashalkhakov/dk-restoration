// made by tools/rig/autorig.py: skeleton's ragdoll, Doom 3's articulated figure
// (made in the model's bind pose; joint() and bone*() name the IQM's joints)
articulatedFigure monster_skeleton {
	settings {
		model "model_skeleton"
		friction 0.01, 0.01, 0.8, 0.5
		suspendSpeed 20, 30, 40, 60
		noMoveTime 1
		noMoveTranslation 10
		noMoveRotation 10
		minMoveTime -1
		maxMoveTime -1
		totalMass -1
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "waist" {
		joint "origin"
		mod orientation
		model box( ( -3.25, -4.33, -2.70 ), ( 3.25, 4.33, 2.70 ) )
		origin ( -1.16, 0.09, 2.23 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "chest" {
		joint "Waist"
		mod orientation
