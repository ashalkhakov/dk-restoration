// made by tools/rig/autorig.py: buboid's ragdoll, Doom 3's articulated figure
// (made in the model's bind pose; joint() and bone*() name the IQM's joints)
articulatedFigure monster_buboid {
	settings {
		model "model_buboid"
		friction 0.01, 0.01, 0.8, 0.5
		suspendSpeed 20, 30, 40, 60
		noMoveTime 1
		noMoveTranslation 10
		noMoveRotation 10
		minMoveTime -1
		maxMoveTime -1
		totalMass -1
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "waist" {
		joint "origin"
		mod orientation
		model box( ( -3.49, -2.50, -4.10 ), ( 3.49, 2.50, 4.10 ) )
		origin ( 5.44, 4.97, -6.66 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
