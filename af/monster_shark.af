// made by tools/rig/creature_rig.py: the shark's ragdoll, Doom 3's articulated figure
// (made in the model's bind pose; joint() names the IQM's joints)
articulatedFigure monster_shark {
	settings {
		model "model_shark"
		friction 0.01, 0.01, 0.8, 0.5
		suspendSpeed 20, 30, 40, 60
		noMoveTime 1
		noMoveTranslation 10
		noMoveRotation 10
		minMoveTime -1
		maxMoveTime -1
		totalMass -1
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "body" {
		joint "origin"
		mod orientation
		model box( ( -19.13, -17.70, -16.46 ), ( 19.13, 17.70, 16.46 ) )
		origin ( -32.51, -9.16, 12.45 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "head" {
		joint "Head"
		mod orientation
		model box( ( -5.44, -7.19, -4.68 ), ( 5.44, 7.19, 4.68 ) )
		origin ( 10.40, -2.05, -2.34 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "headb1" {
