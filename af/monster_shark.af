		mod orientation
		model box( ( -13.89, -7.38, -4.68 ), ( 13.89, 7.38, 4.68 ) )
		origin ( -26.34, 19.22, -1.36 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "tail1" {
		joint "Tail1"
		mod orientation
		model bone( ( -52.35, 1.73, 7.97 ), ( -99.80, 0.00, 2.04 ), 12.54 )
		origin ( -76.08, 0.87, 5.01 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	body "tail2" {
		joint "Tail2"
		mod orientation
		model box( ( -8.55, -4.68, -11.62 ), ( 8.55, 4.68, 11.62 ) )
		origin ( -114.35, -2.00, 7.16 )
		density 0.2
		friction 0.01, 0.01, 0.8
		contents corpse
		clipMask solid, corpse
		selfCollision 1
	}

	universalJoint "Head" {
		body1 "head"
		body2 "body"
		anchor joint( "Head" )
		shafts ( 0.98, 0.10, -0.18 ), ( -0.98, -0.10, 0.18 )
		friction 0.20
		coneLimit ( 0.98, 0.10, -0.18 ), 45
	}

	universalJoint "Headb1" {
		body1 "headb1"
		body2 "body"
		anchor joint( "Headb1" )
		shafts ( 0.95, 0.30, -0.04 ), ( -0.95, -0.30, 0.04 )
