# rigs one model of RIG_MODELS: rig_model <name> <rigger> <model> [key=value...]
rig_model() {
	local name=$1 rigger=$2 model=$3 bones=64 extra=8 fps="" surface="" rest="" rootout="" props="" front="" eyes="" sounds="" parts="" fullwheels="" wheelscale="" nohitbox="" merge="" follow="" bodyparts="" propsplit="" hold="" iqm anims kv
	iqm=$(basename "$model"); iqm=${iqm#m_}
	shift 3
	for kv in "$@"; do
		case $kv in
			bones=*) bones=${kv#bones=} ;;
			extra=*) extra=${kv#extra=} ;;
			fps=*) fps="--fps ${kv#fps=}" ;;
			iqm=*) iqm=${kv#iqm=} ;;
			surface=*) surface="--surface ${kv#surface=}" ;;
			nohitbox=*) nohitbox="--no-hitbox ${kv#nohitbox=}" ;;
			merge=*) merge="--merge ${kv#merge=}" ;;
			rest=*) rest="--rest ${kv#rest=}" ;;
			rootout=1) rootout="--root-out" ;;
			rootout=*) rootout="--root-out-anims ${kv#rootout=}" ;;
			props=*) props="--props ${kv#props=}" ;;
			front=*) front="--front ${kv#front=}" ;;
			eyes=*) eyes="--eyes ${kv#eyes=}" ;;
			sounds=*) sounds="--sounds ${kv#sounds=}" ;;
			parts=*) parts="--parts ${kv#parts=}" ;;
			fullwheels=1) fullwheels="--full-wheels" ;;
			wheelscale=*) wheelscale="--wheel-scale ${kv#wheelscale=}" ;;
			follow=*) follow=${kv#follow=} ;;
			bodyparts=*) bodyparts=${kv#bodyparts=} ;;
			propsplit=*) propsplit=${kv#propsplit=} ;;
			hold=*) hold=${kv#hold=} ;;
			*) die "$name: what is $kv?" ;;
		esac
	done
	anims=$(eval echo "\"\${RIG_ANIMS_$name:-}\"")
	# made in the stage, installed if the validated animations stay the same
	local stage="$OUT/rig/stage/$name" f
	local md3="$DKRES/models/$model.md3" out="$OUT/rig/stage/$name/$iqm"
	rm -rf "$stage"; mkdir -p "$stage"
	cd "$ROOT"
	export RIG_STAGE="$stage"
	case $rigger in
		player) python3 tools/rig/autorig.py $rootout "$md3" "$out" ;;
		lying) python3 tools/rig/autorig.py --lying "$md3" "$out" ;;
		dead) python3 tools/rig/dead_rig.py "$md3" "$out" tools/rig/joints/dead.txt ;;
		human) python3 tools/rig/autorig.py --name "$name" --extra "$extra" $fps $surface $rest $rootout $props --anims "$anims" "$md3" "$out" ;;
		creature) python3 tools/rig/creature_rig.py --bones "$bones" $merge $surface $nohitbox --anims "$anims" "$md3" "$out" "$name" ;;
		vehicle) python3 tools/rig/vehicle_rig.py --name "$name" $front $eyes $sounds $parts $fullwheels $wheelscale "$md3" "$out" ;;
		*) die "$name: no rigger $rigger" ;;
	esac || return 1
	# the bones moved as the parts of the body they should carry, placed by
	# hand (tools/rig/iqm_parts.py; twins carry the mesh): the ninja's
	if [ -n "$bodyparts" ]; then
		python3 tools/rig/iqm_parts.py "$out.iqm" "$bodyparts" || return 1
	fi
	# (after the parts: a bone moved as its part, the skinny worker's waist,
	# carries them)
	# joints that carry no vertex moved with a bone (tools/rig/iqm_follow.py):
	# follow=Waist:origin,Body,Hips, the ragdoll's root body on the pelvis
	if [ -n "$follow" ]; then
		# shellcheck disable=SC2046
		python3 tools/rig/iqm_follow.py "$out.iqm" "${follow%%:*}" $(echo "${follow#*:}" | tr , ' ') || return 1
	fi
	# a prop that is rigid pieces moving apart split into them
	# (tools/rig/iqm_props.py): Usagi's hammer and work
	if [ -n "$propsplit" ]; then
		python3 tools/rig/iqm_props.py "$(sed -n 's/^entityDef[[:space:]]*\([^[:space:]]*\).*/\1/p' "$stage"/def/*.def | head -1)" "$out.iqm" "$propsplit" || return 1
	fi
	# a thing he holds, a model of our own on a joint in his hand, Daikatana's
	# piece of his mesh for it out (tools/rig/iqm_hold.py): the skinny
	# worker's PDA
	if [ -n "$hold" ]; then
		python3 tools/rig/iqm_hold.py "$stage/def" "$out.iqm" "$hold" || return 1
	fi
	if ! grep -q "\"mesh\"[[:space:]]*\"models/rigged/$iqm.iqm\"" "$stage"/def/*.def; then
		echo "rig not installed: its def doesn't name models/rigged/$iqm.iqm"
		return 1
	fi
	if ! python3 tools/rig/rigcheck.py --gate "$stage"/def/*.def "$out.iqm" ${RIG_CHANGE:+--change "$RIG_CHANGE"}; then
		echo "rig kept: validated (the new one in out/rig/stage/$name)"
		return 0
	fi
	for f in "$out".iqm "$out".json "$out"_skin.txt "$out"_*.iqm; do
		[ -f "$f" ] && cp "$f" "$DKRES/models/rigged/"
	done
	cp "$stage"/def/*.def "$ROOT/def/"
	if [ -d "$stage/sound" ]; then cp "$stage"/sound/* "$ROOT/sound/"; fi
	python3 tools/rig/rigcheck.py --restamp "$(sed -n 's/^entityDef[[:space:]]*\([^[:space:]]*\).*/\1/p' "$stage"/def/*.def | head -1)" "${RIG_CHANGE:-}"
	touch "$stage/installed"
}

# ./dk rig [name...]: all of RIG_MODELS by default, $JOBS at a time, each
# one's output in dkres/models/rigged/<name>.log; then how well each fits
# (dkres/models/rigged/results.txt)
cmd_rig() {
	local list name rest failed=0
	mkdir -p "$DKRES/models/rigged"
	if [ "${1:-}" = "--change" ]; then
		export RIG_CHANGE=$2
		shift 2
	fi
	list=$(printf '%s\n' "$RIG_MODELS" | sed '/^[[:space:]]*$/d; /^[[:space:]]*#/d')
	if [ $# -gt 0 ]; then
		list=$(printf '%s\n' "$list" | while read -r name rest; do
			for want in "$@"; do
				if [ "$want" = "$name" ]; then printf '%s %s\n' "$name" "$rest"; fi
			done
		done)
		[ -n "$list" ] || die "no such model in RIG_MODELS: $*"
	fi
	say "rigging $(printf '%s\n' "$list" | wc -l | tr -d ' ') models, $JOBS at a time"
	export -f rig_model die
	export ROOT DKRES OUT $(compgen -v RIG_ANIMS_ || true)
	printf '%s\n' "$list" | xargs -P "$JOBS" -L 1 bash -c '
		mkdir -p "$OUT/rig/stage"
		log="$OUT/rig/stage/$1.log"
		if rig_model "$@" >"$log" 2>&1; then
			if [ -f "$OUT/rig/stage/$1/installed" ]; then
				cp "$log" "$DKRES/models/rigged/$1.log"
				printf "  %-16s %s\n" "$1" "$(grep "error:" "$log" | tail -1 | sed "s/^ *error: //")"
			else
				printf "  %-16s KEPT, validated: %s\n" "$1" "$(grep "validated, would change" "$log" | sed "s/^validated, would change: //" | cut -c1-90)"
			fi
		else
			printf "  %-16s FAILED (out/rig/stage/%s.log)\n" "$1" "$1"; exit 1
		fi' rig || failed=1
	{
		printf '# name rigger model vertexes frames animations bones average worst size\n'
		printf '%s\n' "$RIG_MODELS" | sed '/^[[:space:]]*$/d; /^[[:space:]]*#/d' | while read -r name rigger model rest; do
			local log="$DKRES/models/rigged/$name.log"
			[ -f "$log" ] || continue
			awk -v n="$name" -v r="$rigger" -v m="$model" '
				/vertexes, [0-9]+ frames/ { v = $2; f = $4 }
				/ joints, [0-9]+ animations/ { j = $(NF - 3); a = $(NF - 1) }
				/error:/ { avg = $2; worst = $6; size = $(NF - 1) }
				END { print n, r, m, v, f, a, j, avg, worst, size }' "$log"
		done
	} >"$DKRES/models/rigged/results.txt"
	[ $failed = 0 ] || die "some models failed to rig"
	rig_outfits
	# what was validated and has changed (tools/rig/validated.json)
	cmd_rigcheck || true
}

# ./dk rigcheck: the rigs' animations validated in the viewer (./dk viewer,
# tools/rig/validated.json) whose rig has changed since: to validate again.
# An autorig change that changes them isn't committed till they have been
cmd_rigcheck() {
	(cd "$ROOT" && python3 tools/rig/rigcheck.py)
}

# OUTFITS: a character's other outfit, rigged on its own (RIG_MODELS), on the
# character's rig: one IQM with both, the outfit's animations too
# (tools/rig/outfit.py: models/rigged/<character>_outfits.iqm, a .skin each);
# the character's def and the outfit's on it, each in its skin. A line:
#   character  outfit  prefix (its surfaces' names in the IQM)
# (none yet: Hiro's gi on Hiro's rig shears where the two rigs' joints are
# apart; it needs the gi rigged on Hiro's joints first)
OUTFITS="
"
rig_outfits() {
	local char outfit prefix def
	printf '%s\n' "$OUTFITS" | sed '/^[[:space:]]*$/d; /^[[:space:]]*#/d' | while read -r char outfit prefix; do
		def=$ROOT/def/char_$char.def
		[ -f "$def" ] || def=$ROOT/def/rig_$char.def
		(cd "$ROOT" && python3 tools/rig/outfit.py --defs "$def" "def/rig_$outfit.def" "$DKRES/models/rigged/$char.iqm" \
			"$DKRES/models/rigged/$outfit.iqm" "$prefix" "$DKRES/models/rigged/${char}_outfits") \
			>"$DKRES/models/rigged/${char}_outfits.log" 2>&1 \
			|| die "$char in $outfit failed (dkres/models/rigged/${char}_outfits.log)"
		printf '  %-16s %s\n' "$char+$outfit" "$(tail -1 "$DKRES/models/rigged/${char}_outfits.log" | sed 's/^ *//')"
	done
}

# Daikatana's cinematics (cin/scripts/*.script) as ours: out/cine/cameras,
# script and def (tools/cine/cine_convert.py). The repository's cine/cameras
# and cine/script hold our own and our edits: assembled over them, by name.
# The characters' cinematic animations come first: each of Daikatana's
# cinematic models of a rigged character (models/cinematic/c_<prefix><map>)
# has its animations moved onto the character's rig, in place
# (tools/rig/retarget.py: models/rigged/<character>_<map>.iqm and .json),
# unless that's done already.
CINE_CHARACTERS="hiro:c_hiro_ mikiko:c_mikiko_ superfly:c_super_ usagi:c_usagi_ tatsuo:c_tatsuo_ kage:c_kage_"
cmd_cine() {
	local c name prefix only f tag out
	for c in $CINE_CHARACTERS; do
		# name:prefix[:only]: those of its cinematic models, or only <prefix><only>
		name=${c%%:*} prefix=${c#*:} only=""
		case $prefix in *:*) only=${prefix#*:} prefix=${prefix%%:*} ;; esac
		[ -e "$DKRES/models/rigged/$name.iqm" ] || continue
		for f in "$DKRES"/models/cinematic/"$prefix$only"*.md3; do
			[ -e "$f" ] || continue
			tag=$(basename "$f" .md3)
			tag=${tag#"$prefix"}
			out="$DKRES/models/rigged/${name}_$tag"
			[ "$out.json" -nt "$f" ] && [ "$out.json" -nt "$DKRES/models/rigged/$name.iqm" ] && continue
			echo "  $name: $tag"
			(cd "$ROOT" && python3 tools/rig/retarget.py "$name" "$f" "$out" >"$OUT/retarget_${name}_$tag.log" 2>&1) \
				|| echo "  $name $tag: retargeting failed (see $OUT/retarget_${name}_$tag.log)"
		done
	done
	rm -rf "$OUT/cine"
	(cd "$ROOT" && python3 tools/cine/cine_convert.py "$DKRES" "$OUT/cine" "$@") || die "converting the cinematics failed"
}

cmd_extract() {
	local step
	[ $# -gt 0 ] || die "name the steps: paks envs textures skins models sounds ui levelshots, or all"
	[ "$1" = all ] && set -- envs textures skins models sounds ui levelshots
	for step in "$@"; do
		type "step_$step" >/dev/null 2>&1 || die "no extract step $step"
		say "extract: $step"
		"step_$step"
	done
}

# -------------------------------------------------------------------- convert

# the maps people play: those of scripts/arenas.txt, and EXTRA_MAPS
default_maps() {
	sed -n 's/^[[:space:]]*map[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/scripts/arenas.txt"
	printf '%s\n' $EXTRA_MAPS
}

cmd_convert() {
	local converter map failed=""
	converter=$(tool bsp-sekai/bspsekai)
	[ $# -gt 0 ] || set -- $(default_maps)
	mkdir -p "$OUT/maps" "$DKRES/scripts"
	# the converter leaves out shaders the other maps' files define already,
	# so a map's own file goes before it is converted again
	for map in "$@"; do
		rm -f "$DKRES/scripts/${map}_gen.shader" "$OUT/maps/$map.cm"
	done
	for map in "$@"; do
		[ -f "$DKRES/maps/$map.bsp" ] || die "no Daikatana map $DKRES/maps/$map.bsp"
		printf 'convert %-8s ' "$map"
		if (cd "$DKRES" && "$converter" none "maps/$map.bsp" quake3 "$OUT/maps/$map.bsp") >"$OUT/$map.log" 2>&1; then
			grep -h 'WARNING' "$OUT/$map.log" | head -3 || true
			# its entities changed by hand (maps/<map>.ent: added, changed,
			# deleted; tools/maps/ent_overrides.py), what the converter
			# doesn't know
			if [ -f "$ROOT/maps/$map.ent" ] && ! python3 "$ROOT/tools/maps/ent_overrides.py" "$OUT/maps/$map.bsp" \
					"$ROOT/maps/$map.ent" >>"$OUT/$map.log" 2>&1; then
				echo "FAILED: maps/$map.ent, see out/$map.log"
				failed="$failed $map"
				continue
			fi
			# the rungs of ladders drawn by an alpha tested texture
			python3 "$ROOT/tools/maps/ladder_rungs.py" "$OUT/maps/$map.bsp" "$DKRES/scripts" "$DKRES" \
				"$OUT/maps/$map.ladders" >>"$OUT/$map.log" 2>&1 || true
			# its baked light, from the repository (./dk lightmaps, bakegrids):
			# the lightmaps external (maps/<map>/lm_NNNN), where they go
			rm -rf "${OUT:?}/maps/$map" "$OUT/maps/$map.lightgrid"
			if [ -f "$ROOT/lightmaps/$map.lmcoords" ]; then
				if python3 "$ROOT/tools/maps/lightmap_coords.py" apply "$OUT/maps/$map.bsp" "$ROOT/lightmaps/$map.lmcoords" \
					>>"$OUT/$map.log" 2>&1; then
					cp -R "$ROOT/lightmaps/$map" "$OUT/maps/$map"
				else
					echo "its lightmaps don't fit it any more:"; tail -1 "$OUT/$map.log"
				fi
			fi
			[ -f "$ROOT/lightmaps/$map.lightgrid" ] && cp "$ROOT/lightmaps/$map.lightgrid" "$OUT/maps/"
			echo ok
		else
			echo "FAILED, see out/$map.log"
			failed="$failed $map"
		fi
	done
	[ -z "$failed" ] || die "converting failed:$failed"
}

# ------------------------------------------------------------------- the mod

# The mod folder <dir>/dkres, made of links to the working trees (link) or
# of copies (copy).
assemble() {
	local mod=$1/$GAME mode=$2 d f lib
	put() {
		if [ "$mode" = link ]; then
			rm -rf "${2:?}"
			ln -s "$1" "$2"
		elif [ -d "$1" ]; then
			mkdir -p "$2"
			rsync -aL --delete --exclude '*.cm' "$1/" "$2/"
		else
			rm -f "${2:?}"
			cp -L "$1" "$2"
		fi
	}

	mkdir -p "$mod/ui" "$mod/scripts"
	for d in textures env pics sounds models skins fonts music levelshots; do
		[ -e "$DKRES/$d" ] && put "$DKRES/$d" "$mod/$d"
	done
	# the maps' scripts (maps/<map>.script) go with the converted maps
	for f in "$ROOT"/maps/*.script; do
		[ -e "$f" ] && mkdir -p "$OUT/maps" && cp -f "$f" "$OUT/maps/"
	done
	put "$OUT/maps" "$mod/maps"
	put "$ROOT/effects" "$mod/effects"
	put "$ROOT/characters" "$mod/characters"
	put "$ROOT/gfx" "$mod/gfx"		# (our own images: a lamp's beam, tools/models/make_lampbeam.py)
	# the defs: this repository's, the converted cinematics' actors, and the
	# monsters' frame commands from Daikatana's sound tables (tools/vsc)
	rm -rf "$mod/def" "$OUT/frames"
	mkdir -p "$mod/def" "$OUT/frames"
	[ -d "$DKRES/sounds" ] && python3 "$ROOT/tools/vsc/vsc_frames.py" "$DKRES" "$OUT/frames/dk_monster_frames.def"
	for f in "$ROOT"/def/* "$OUT"/cine/def/* "$OUT"/frames/*.def; do
		[ -e "$f" ] && put "$f" "$mod/def/$(basename "$f")"
	done
	# the cinematics: the converted ones, then ours by the same names in their
	# place; cine/maps/<map>.script includes a map's (the game compiles it
	# with the map's script)
	rm -rf "$mod/cameras" "$mod/cine"
	mkdir -p "$mod/cameras" "$mod/cine/maps"
	for f in "$OUT"/cine/cameras/*.camera "$ROOT"/cine/cameras/*.camera; do
		[ -e "$f" ] && put "$f" "$mod/cameras/$(basename "$f")"
	done
	for f in "$OUT"/cine/script/*.script "$ROOT"/cine/script/*.script; do
		[ -e "$f" ] && put "$f" "$mod/cine/$(basename "$f")"
	done
	for f in "$OUT"/cine/maps/*.script "$ROOT"/cine/maps/*.script; do
		[ -e "$f" ] && put "$f" "$mod/cine/maps/$(basename "$f")"
	done
	# Daikatana's action scripts (cin/aiscripts/<map>.sca) as Doom 3 ones,
	# ai/maps/<map>.script, the game compiling a map's with its script; ours
	# by the same names, in ai/maps, in their place
	rm -rf "$OUT/ai" "$mod/ai"
	mkdir -p "$mod/ai/maps"
	[ -d "$DKRES/cin/aiscripts" ] && python3 "$ROOT/tools/aiscript/sca_convert.py" "$DKRES" "$OUT/ai/maps"
	for f in "$OUT"/ai/maps/*.script "$ROOT"/ai/maps/*.script; do
		[ -e "$f" ] && put "$f" "$mod/ai/maps/$(basename "$f")"
	done
	put "$ROOT/script" "$mod/script"
	put "$ROOT/af" "$mod/af"
	put "$ROOT/sound" "$mod/sound"
	put "$ROOT/gameinfo.txt" "$mod/gameinfo.txt"

	for f in "$ROOT"/ui/*; do
		put "$f" "$mod/ui/$(basename "$f")"
	done
	[ -e "$DKRES/ui/assets" ] && put "$DKRES/ui/assets" "$mod/ui/assets"

	# shaders: those of the maps, the models' alpha-tested skins (qwalk's
	# gen_skins.shader) and those of this repository
	find "$mod/scripts" \( -name '*_gen.shader' -o -name gen_skins.shader \) -exec rm -f {} +
	for f in "$DKRES"/scripts/*_gen.shader "$DKRES"/scripts/gen_skins.shader "$ROOT"/scripts/*; do
		[ -e "$f" ] && put "$f" "$mod/scripts/$(basename "$f")"
	done

	# settings, and the game modules; replaced rather than overwritten,
	# macOS refuses a signed library changed in place
	cp -f "$ROOT"/mint/* "$mod/"
	for lib in "$BUILD"/mint-arena/*.dylib "$BUILD"/mint-arena/*.so "$BUILD"/mint-arena/*.dll; do
		[ -e "$lib" ] || continue
		rm -f "$mod/$(basename "$lib")"
		cp "$lib" "$mod/"
	done
	ls "$mod"/mint-cgame_* >/dev/null 2>&1 || die "the game isn't built; run ./dk build mint-arena"
}

# runs the engine with its home in <home>
play() {
	local home=$1 e
	shift
	e=$(engine)
	[ -n "$Q3_DIR" ] || die "set Q3_DIR in dk.local to Quake 3's folder"
	rm -f "$home"/*.pid "$home/$GAME"/*.pid
	cd "$(dirname "$e")"
	"$e" +set fs_basepath "$Q3_DIR" +set fs_homepath "$home" +set fs_game "$GAME" \
		+set vm_game 0 +set vm_cgame 0 +set sv_pure 0 +set fs_pakWarningDialog 0 \
		+set vm_gameHeapMegs "${GAME_HEAP_MEGS:-64}" \
		+set com_renderer "$RENDERER" "$@"
}

cmd_run() {
	assemble "$OUT/home" link
	(play "$OUT/home" "$@")
}

cmd_install() {
	local dir=${1:-${INSTALL_DIR:-$Q3_DIR}}
	[ -n "$dir" ] || die "name a folder, or set INSTALL_DIR in dk.local"
	say "installing into $dir/$GAME"
	assemble "$dir" copy
}

# ---------------------------------------------------------------- testing

# runs a script in the engine, its own home so it doesn't touch yours:
# play_script <name> <map> <commands...>; map "-" for the main menu; DK_ARGS
# adds to the command line, before the map (+set cine_firstShot 30)
play_script() {
	local name=$1 map=$2 home=$OUT/test-home devmap=()
	shift 2
	[ "$map" = - ] || devmap=(+devmap "$map")
	assemble "$home" link
	mkdir -p "$home/$GAME"
	printf '%s\n' "$@" quit >"$home/$GAME/dk_$name.cfg"
	(play "$home" +set r_fullscreen 0 +set r_mode -1 +set r_customwidth 960 +set r_customheight 600 \
		+set s_initsound 0 +set bot_enable "${BOTS:-0}" +set g_gametype "${GAMETYPE:-0}" +set cg_draw2D "${HUD:-0}" +set cg_drawGun "${HUD:-0}" \
		${DK_ARGS:-} ${devmap[@]+"${devmap[@]}"} +exec "dk_$name.cfg") >"$OUT/test/$name.log" 2>&1 || true
}

cmd_shots() {
	[ $# -ge 1 ] || die "usage: ./dk shots <map> [tag]"
	local map=$1 tag=${2:-shots} shots="" i=0 x y z yaw
	mkdir -p "$OUT/test" "$OUT/shots/$tag"
	rm -f "$OUT/test-home/$GAME/screenshots/${map}_"*
	while read -r x y z yaw; do
		shots="$shots|setviewpos $x $y $z $yaw 0|wait 60|screenshotJPEG ${map}_$i|wait 10"
		i=$((i + 1))
	done <<EOF
$(python3 "$ROOT/tools/dk_spawns.py" "$OUT/maps/$map.bsp" 4)
EOF
	# with the HUD, the weapon selector up in each, a centre print in the
