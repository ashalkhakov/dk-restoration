# ./dk lightmaps [map...]: each map's lightmaps baked again by q3map2, from
#   Daikatana's own lights (tools/maps/bsp_lights.py): its light entities,
#   their caps as fades, LIGHT_DEFAULT_CAP for those without; its faces'
#   surface lights; its sky as q3map2's sky light; see-through faces cast
#   no shadow. Baked twice the same way, all of it and the light entities'
#   direct light alone, the one less the other: the game draws that part
#   with dynamic lights (cg_staticLightScale), the lightmaps keep the rest
#   (worldspawn "_bounceLightmaps"). Baked again after the map is changed;
#   the light grids (./dk bakegrids) after these. Kept in the repository,
#   the lightmaps as PNG (lightmaps/<map>/lm_NNNN.png) and where they go on
#   the map (lightmaps/<map>.lmcoords, tools/maps/lightmap_coords.py), put
#   back whenever the map is converted, while its geometry is the same.
LIGHT_CAP_SCALE=${LIGHT_CAP_SCALE:-1.25}
LIGHT_DEFAULT_CAP=${LIGHT_DEFAULT_CAP:-55}
LIGHT_SKY_SCALE=${LIGHT_SKY_SCALE:-0.5}
# Daikatana's 16 units a luxel, as matched against its lightmaps, into
# external lightmaps; finer (-samplesize 8) takes about 40 times longer
LIGHT_OPTIONS=${LIGHT_OPTIONS:--bounce 2 -bouncescale 2 -samples 2 -filter -external -lightmapsize 1024}

# light_pass <bake|bake-direct> <map> <out.bsp> <q3map2 options...>: one bake
# of out/lightmaps/<map>.game.bsp
light_pass() {
	local mode=$1 map=$2 out=$3 home=$OUT/test-home scripts status
	shift 3
	scripts=$home/$GAME/scripts
	python3 "$ROOT/tools/maps/bsp_lights.py" "$mode" "$OUT/lightmaps/$map.game.bsp" "$DKRES/maps/$map.bsp" "$out" \
		"$scripts/zz_lightbake.shader" "$LIGHT_CAP_SCALE" "$LIGHT_DEFAULT_CAP" "$LIGHT_SKY_SCALE" >/dev/null || return 1
	# q3map2 reads the shaders shaderlist.txt names, only
	(cd "$scripts" && ls -- *.shader | sed 's/\.shader$//') >"$scripts/shaderlist.txt"
	rm -rf "${out%.bsp}"
	"$(tool netradiant/q3map2)" -game quake3 -fs_basepath "$home" -fs_game "$GAME" -light -threads "$JOBS" -nocollapse "$@" \
		"$out" >"${out%.bsp}.log" 2>&1
	status=$?
	rm -f "$scripts/zz_lightbake.shader" "$scripts/shaderlist.txt"
	return $status
}

cmd_lightmaps() {
	local map work=$OUT/lightmaps start direct
	tool netradiant/q3map2 >/dev/null
	[ $# -gt 0 ] || set -- $(default_maps)
	assemble "$OUT/test-home" link
	mkdir -p "$work"
	# the direct light alone: the same, without bouncing
	direct=$(printf '%s' "$LIGHT_OPTIONS" | sed -E 's/-bounce [0-9]+//; s/-fastbounce//')
	for map in "$@"; do
		printf 'lightmaps %-8s ' "$map"
		[ -f "$DKRES/maps/$map.bsp" ] && [ -f "$OUT/maps/$map.bsp" ] || { echo "not converted"; continue; }
		cp "$OUT/maps/$map.bsp" "$work/$map.game.bsp"
		start=$(date +%s)
		# shellcheck disable=SC2086
		light_pass bake "$map" "$work/$map.bsp" $LIGHT_OPTIONS || { echo "FAILED, see out/lightmaps/$map.log"; continue; }
		# shellcheck disable=SC2086
		light_pass bake-direct "$map" "$work/$map-direct.bsp" $direct || { echo "FAILED, see out/lightmaps/$map-direct.log"; continue; }
		python3 "$ROOT/tools/maps/bsp_lights.py" subtract "$work/$map.bsp" "$work/$map-direct.bsp" "$work/$map" "$work/$map-direct" \
			|| { echo "FAILED"; continue; }
		python3 "$ROOT/tools/maps/bsp_lights.py" restore "$work/$map.game.bsp" "$work/$map.bsp" bounce
		cp "$work/$map.bsp" "$OUT/maps/$map.bsp"
		rm -rf "${OUT:?}/maps/$map"
		[ -d "$work/$map" ] && cp -R "$work/$map" "$OUT/maps/$map"
		# kept in the repository, for the map converted again (cmd_convert):
		# where they go, and the lightmaps as PNG (the engine takes those
		# for the TGAs q3map2 writes)
		rm -rf "${ROOT:?}/lightmaps/$map"
		mkdir -p "$ROOT/lightmaps/$map"
		python3 "$ROOT/tools/maps/lightmap_coords.py" save "$OUT/maps/$map.bsp" "$ROOT/lightmaps/$map.lmcoords" >/dev/null
		for f in "$OUT/maps/$map"/lm_*.tga; do
			magick "$f" -define png:compression-level=9 "$ROOT/lightmaps/$map/$(basename "$f" .tga).png"
		done
		rm -rf "${OUT:?}/maps/$map"
		cp -R "$ROOT/lightmaps/$map" "$OUT/maps/$map"
		echo "$(( $(date +%s) - start )) s, $(ls "$OUT/maps/$map" 2>/dev/null | wc -l | tr -d ' ') external lightmaps"
	done
}

# ./dk bakegrids [map...]: each map's rooms and light grid (bakeLightGrid,
#   renderergl2's tr_lightgrid.c), written next to it in out/maps. Baked
#   again after the map is converted again.
cmd_bakegrids() {
	local map failed=""
	[ $# -gt 0 ] || set -- $(default_maps)
	mkdir -p "$OUT/test"
	for map in "$@"; do
		printf 'bake %-8s ' "$map"
		play_script "bake_$map" "$map" "wait 50" "bakeLightGrid" "wait 5"
		if ! grep -q "^bakeLightGrid: maps/" "$OUT/test/bake_$map.log"; then
			echo "FAILED, see out/test/bake_$map.log"
			failed="$failed $map"
			continue
		fi
		grep -h "^bakeLightGrid: maps/" "$OUT/test/bake_$map.log" | sed 's/^bakeLightGrid: //'
		# kept in the repository, for the map converted again (cmd_convert)
		mkdir -p "$ROOT/lightmaps"
		cp "$OUT/maps/$map.lightgrid" "$ROOT/lightmaps/"
	done
	[ -z "$failed" ] || die "baking failed:$failed"
}

# ./dk rigshots [name...]: the rigged models in e1m1a, three to a shot,
# before its spawn points (each way they face), to compare with
# Daikatana's (DEAD=1 kills the middle one: its ragdoll); out/shots/rig/
cmd_rigshots() {
	local map=e1m1a spots shots="" i=0 n x y z yaw turn
	mkdir -p "$OUT/test" "$OUT/shots/rig"
	rm -f "$OUT/test-home/$GAME/screenshots/rig_"* "$OUT/shots/rig/"*
	[ $# -gt 0 ] || set -- $(printf '%s\n' "$RIG_MODELS" | sed '/^[[:space:]]*$/d; /^[[:space:]]*#/d' | awk '{print $1}')
	spots=$(python3 "$ROOT/tools/dk_spawns.py" "$OUT/maps/$map.bsp" 8)
	while [ $# -gt 0 ]; do
		for turn in 0 90 180 270; do
			while read -r x y z yaw; do
				[ $# -gt 0 ] || break 2
				shots="$shots|setviewpos $x $y $z $(( (yaw + turn) % 360 )) 10|wait 5"
				for n in -64 0 64; do
					[ $# -gt 0 ] || break
					shots="$shots|spawncharacter model_$1 \"\" 0 $n"
					shift
				done
				# DEAD=1: the middle one killed, to see its ragdoll
				[ "${DEAD:-0}" = 0 ] || shots="$shots|wait 20|damage 1000 aim|wait 60"
				shots="$shots|wait 40|screenshotJPEG rig_$i|wait 10"
				i=$((i + 1))
			done <<EOF
$spots
EOF
		done
	done
	local IFS='|'
	# shellcheck disable=SC2086
	play_script rigshots "$map" "wait 200" ${shots#|}
	unset IFS
	mv "$OUT/test-home/$GAME/screenshots/rig_"*.jpg "$OUT/shots/rig/" 2>/dev/null \
		|| die "no screenshots, see out/test/rigshots.log"
	command -v magick >/dev/null && contact_sheet "$OUT/shots/rig.jpg" "$OUT"/shots/rig/rig_*.jpg
	ls "$OUT/shots/rig/"
}

