// cine_base.script -- what cinematics use: the converted ones
// (tools/cine/cine_convert.py, Daikatana's) and ours. A cinematic is a
// namespace whose play() puts the view on its cameras one after another
// (sys.setCamera), each shot starting its actors' threads and its sounds.
//
// While a cinematic is skipped (sys.skippingCinematic()), waits end at once
// and the actors' moves, turns and animations here end where they would.
//
// An actor has its place (keys "cine_anchor", "cine_anchorYaw"), as
// Daikatana's had: where it was spawned, put, or walked or turned to. Every
// animation starts there: what one moved it by (Daikatana baked that in) is
// only how it's drawn while it plays, not where the next starts.

/*
================
cine_actor

a cinematic's character: no mind of its own, its cinematic's script moves
and animates it
================
*/
object cine_actor : monster_base {
	void		init();
	void		state_Idle();
};

void cine_actor::init() {
	skill = sys.strToFloat( sys.getcvar( "g_skill" ) );
}

void cine_actor::state_Idle() {
}

/*
================
cine_camera

a camera playing cameras/<name>.camera, for sys.setCamera; the last one made
goes (it has been cut from)
================
*/
entity	cine_lastCamera;

entity cine_camera( string name ) {
	entity cam;

	sys.setSpawnArg( "camera", name );
	cam = sys.spawn( "func_cameraspline" );
	if ( cine_lastCamera != $null_entity ) {
		cine_lastCamera.remove();		// (the view goes to the new one this frame)
	}
	cine_lastCamera = cam;
	return cam;
}

/*
================
cine_anchor

the actor's place from now on (cine_toAnchor)
================
*/
void cine_anchor( entity actor, vector origin, float yaw ) {
	actor.setKey( "cine_anchor", "" + origin );
	actor.setKey( "cine_anchorYaw", "" + yaw );
}

/*
================
cine_toAnchor

the actor back at its place, as an animation starts: across the floor, as
high as it stands now (spawned in the air, it has come down to the floor:
back up there, it would drop again)
================
*/
void cine_toAnchor( entity actor ) {
	vector	place;

	place = actor.getVectorKey( "cine_anchor" );
	place_z = actor.getOrigin() * '0 0 1';
	actor.setOrigin( place );
	actor.setAngles( '0 1 0' * actor.getFloatKey( "cine_anchorYaw" ) );
	actor.turnTo( actor.getFloatKey( "cine_anchorYaw" ) );
}

/*
================
cine_place

the actor put there, facing yaw: its place now (Daikatana's teleport)
================
*/
void cine_place( entity actor, vector origin, float yaw ) {
	if ( actor == $null_entity ) {
		return;
	}
	cine_anchor( actor, origin, yaw );
	cine_toAnchor( actor );
}

/*
================
cine_idle

the actor idles with that animation, at its place
================
*/
void cine_idle( entity actor, string anim ) {
	if ( actor == $null_entity ) {
		return;
	}
	cine_toAnchor( actor );
	actor.playCycle( ANIMCHANNEL_LEGS, anim );
}

/*
================
cine_spawn

an actor of that def, there, facing yaw, named
================
*/
entity cine_spawn( string def, vector origin, float yaw, string name ) {
	entity actor;

	sys.setSpawnArg( "origin", "" + origin );
	sys.setSpawnArg( "angle", "" + yaw );
	actor = sys.spawn( def );
	if ( actor != $null_entity ) {
		actor.setName( name );
		cine_anchor( actor, origin, yaw );
		if ( actor.hasAnim( ANIMCHANNEL_LEGS, "amba" ) ) {
			actor.playCycle( ANIMCHANNEL_LEGS, "amba" );		// its idle, until it's told otherwise
		}
	}
	return actor;
}

/*
================
cine_enter

Daikatana's spawning of a character in a cinematic: its one actor (the
cinematic's, for that character, from its first entrance on) put there and
shown, "who" (Daikatana's entity) its owner until another's entrance
================
*/
entity cine_enter( entity actor, string def, vector origin, float yaw, string name, string who ) {
	if ( actor == $null_entity ) {
		actor = cine_spawn( def, origin, yaw, name );
	} else {
		actor.show();
		actor.setOrigin( origin );
		actor.setAngles( '0 1 0' * yaw );
		actor.turnTo( yaw );
		cine_anchor( actor, origin, yaw );
		if ( actor.hasAnim( ANIMCHANNEL_LEGS, "amba" ) ) {
			actor.playCycle( ANIMCHANNEL_LEGS, "amba" );
		}
	}
	if ( actor != $null_entity ) {
		actor.setKey( "cine_owner", who );
	}
	return actor;
}

/*
================
cine_exit

Daikatana's removal: the actor hidden, if it's still that entity's (not
another's that has entered since)
================
*/
void cine_exit( entity actor, string who ) {
	if ( actor != $null_entity && actor.getKey( "cine_owner" ) == who ) {
		actor.hide();
	}
}

/*
================
cine_remove

the actor gone, if it's there
================
*/
void cine_remove( entity actor ) {
	if ( actor != $null_entity ) {
		actor.remove();
	}
}

/*
================
cine_until

waits until then
================
*/
void cine_until( float t ) {
	if ( t > sys.getTime() ) {
		sys.wait( t - sys.getTime() );
	}
}

/*
================
cine_play

the actor plays the animation through
================
*/
void cine_play( entity actor, string anim ) {
	string	who;

	if ( actor == $null_entity ) {
		return;
	}
	who = actor.getKey( "cine_owner" );
	cine_toAnchor( actor );
	actor.playAnim( ANIMCHANNEL_LEGS, anim );
	while( !actor.animDone( ANIMCHANNEL_LEGS, 0 ) && !sys.skippingCinematic() && actor.getKey( "cine_owner" ) == who ) {
		sys.waitFrame();
	}
}

/*
================
cine_playMove

the actor plays an animation in place, from its place, while the game
carries it along what the animation once moved it by (Daikatana baked it
in; we don't): move is forward and to the left of how it faced, turn
degrees by the end, over secs. Its place stays: the next animation starts
there again, as Daikatana's did
================
*/
void cine_playMove( entity actor, string anim, vector move, float turn, float secs ) {
	vector	ang;
	vector	from;
	vector	to;
	float	t0;
	float	f;
	string	who;

	if ( actor == $null_entity ) {
		return;
	}
	who = actor.getKey( "cine_owner" );
	cine_toAnchor( actor );
	ang = actor.getAngles();
	from = actor.getOrigin();
	to = from + sys.angToForward( '0 1 0' * ang_y ) * move_x - sys.angToRight( '0 1 0' * ang_y ) * move_y;
	actor.playAnim( ANIMCHANNEL_LEGS, anim );
	t0 = sys.getTime();
	while( !actor.animDone( ANIMCHANNEL_LEGS, 0 ) && !sys.skippingCinematic() ) {
		f = ( sys.getTime() - t0 ) / secs;
		if ( f > 1 ) {
			f = 1;
		}
		actor.setOrigin( from + ( to - from ) * f );
		actor.turnTo( ang_y + turn * f );
		sys.waitFrame();
		if ( actor.getKey( "cine_owner" ) != who ) {
			return;		// another has entered as this actor
		}
	}
	actor.setOrigin( to );
	actor.turnTo( ang_y + turn );
}

/*
================
cine_move

the actor walks there (or runs: gait "runa"), at its walk_speed (run_speed),
playing its walk, then stands: straight there, as Daikatana's did, not as
its legs would find a way (the map may have no way for them, or a door
not yet open)
================
*/
void cine_move( entity actor, vector dest, string gait ) {
	vector	from;
	vector	dir;
	vector	at;
	float	speed;
	float	dist;
	float	t0;
	float	f;
	string	who;

	if ( actor == $null_entity ) {
		return;
	}
	who = actor.getKey( "cine_owner" );
	cine_toAnchor( actor );
	if ( gait == "runa" ) {
		speed = actor.getFloatKey( "run_speed" );
	} else {
		speed = actor.getFloatKey( "walk_speed" );
	}
	if ( speed <= 0 ) {
		speed = 60;
	}
	from = actor.getOrigin();
	dir = dest - from;
	dir_z = 0;
	dist = sys.vecLength( dir );
	if ( dist > 1 ) {
		actor.turnTo( sys.VecToAngles( dir ) * '0 1 0' );
		if ( actor.hasAnim( ANIMCHANNEL_LEGS, gait ) ) {
			actor.playCycle( ANIMCHANNEL_LEGS, gait );
		}
		t0 = sys.getTime();
		while( !sys.skippingCinematic() ) {
			f = ( sys.getTime() - t0 ) * speed / dist;
			if ( f >= 1 ) {
				break;
			}
			at = from + dir * f;
			at_z = actor.getOrigin() * '0 0 1';		// (on the floor, as gravity has it)
			actor.setOrigin( at );
			sys.waitFrame();
			if ( actor.getKey( "cine_owner" ) != who ) {
				return;		// another has entered as this actor
			}
		}
	}
	at = from + dir;
	at_z = actor.getOrigin() * '0 0 1';
	actor.setOrigin( at );
	cine_anchor( actor, at, actor.getAngles() * '0 1 0' );
	if ( actor.hasAnim( ANIMCHANNEL_LEGS, "amba" ) ) {
		actor.playCycle( ANIMCHANNEL_LEGS, "amba" );
	}
}

/*
================
cine_turn

the actor turns to face yaw
================
*/
void cine_turn( entity actor, float yaw ) {
	string	who;

	if ( actor == $null_entity ) {
		return;
	}
	who = actor.getKey( "cine_owner" );
	actor.setKey( "cine_anchorYaw", "" + yaw );
	actor.turnTo( yaw );
	while( !actor.facingIdeal() && actor.getKey( "cine_owner" ) == who ) {
		if ( sys.skippingCinematic() ) {
			actor.setAngles( '0 1 0' * yaw );
			return;
		}
		sys.waitFrame();
	}
}

/*
================
cine_use

the actor uses the entity of that name (a door, a button)
================
*/
void cine_use( string name, entity actor ) {
	entity ent;

	ent = sys.getEntity( name );
	if ( ent != $null_entity ) {
		ent.activate( actor );
	}
}

/*
================
cine_start / cine_finish

a cinematic starts black (its first shot fades it in, if it means to), and
ends with the players' own eyes back, its loops stopped and the screen clear
================
*/
void cine_start() {
	cine_lastCamera = $null_entity;
}

void cine_finish() {
	sys.stopGlobalLoops();
	sys.firstPerson();
	sys.fadeTo( '0 0 0', 0, 0 );
	if ( cine_lastCamera != $null_entity ) {
		cine_lastCamera.remove();
		cine_lastCamera = $null_entity;
	}
}
