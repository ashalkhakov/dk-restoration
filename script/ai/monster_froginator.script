// monster_froginator.script -- Daikatana's Froginator: it gets about by
// leaping. It hops after you, two or three hundred units a hop, a moment
// crouched between; near enough, it leaps at where you'll be, and a leap that
// meets you hurts and knocks you back. Up close it bites. A leap is a throw:
// the game flies it on its arc, and one into a wall hurts it (kills it, at
// one health). In water it swims. Its spit at range is to come, with a
// projectile of its own.

object monster_froginator : monster_base {
	void		state_Combat();
	void		hop();
	void		leapAt();
	void		swim();
	void		attack();
	void		pain();
	void		crouch();
	boolean		throwTo( vector dest, float up, float maxSpeed, string anim );
	vector		floorUnder( vector pos );
};

/*
================
monster_froginator::state_Combat
================
*/
void monster_froginator::state_Combat() {
	float dist;

	while( 1 ) {
		if ( !getEnemy() ) {
			setState( "state_Idle" );
			return;
		}
		if ( AI_PAIN && sys.random( 1 ) < 0.2 ) {
			pain();
		}
		dist = enemyRange();
		if ( AI_IN_WATER ) {
			swim();
		} else if ( !AI_ONGROUND ) {
			sys.waitFrame();
		} else if ( dist < 70 && AI_ENEMY_VISIBLE ) {
			attack();
		} else if ( dist < getFloatKey( "leap_range" ) && AI_ENEMY_VISIBLE ) {
			leapAt();
		} else {
			hop();
		}
		sys.waitFrame();
	}
}

/*
================
monster_froginator::floorUnder

where its box stands, under pos (pos if there's no floor near)
================
*/
vector monster_froginator::floorUnder( vector pos ) {
	if ( sys.trace( pos + '0 0 48', pos - '0 0 160', getMins(), getMaxs(), CONTENTS_SOLID | CONTENTS_MONSTERCLIP, self ) < 1 ) {
		return sys.getTraceEndPos();
	}
	return pos;
}

/*
================
monster_froginator::throwTo

thrown to land at dest, as its animation goes; then in the air until it
lands, three seconds at most. false, and it stays put, if something's in the
way of its arc
================
*/
boolean monster_froginator::throwTo( vector dest, float up, float maxSpeed, string anim ) {
	vector	vel;
	float	t;

	vel = getJumpVelocity( dest, up, maxSpeed );
	if ( vel == '0 0 0' ) {
		return false;
	}
	turnToPos( dest );
	playAnim( ANIMCHANNEL_LEGS, anim );
	startSound( "snd_leap", CHAN_VOICE, false );
	setLinearVelocity( vel );

	t = sys.getTime() + 3;
	sys.waitFrame();
	while( !AI_ONGROUND && sys.getTime() < t ) {
		if ( AI_IMPACT ) {
			startSound( "snd_impact", CHAN_BODY, false );
		}
		if ( AI_LEAP_HIT ) {
			startSound( "snd_attack", CHAN_VOICE, false );
		}
		sys.waitFrame();
	}
	startSound( "snd_land", CHAN_BODY, false );
	return true;
}

/*
================
monster_froginator::crouch

a moment on the ground between leaps: longer on easy
================
*/
void monster_froginator::crouch() {
	float t;

	playCycle( ANIMCHANNEL_LEGS, "amba" );
	t = sys.getTime() + ( 0.45 - skill * 0.1 ) + sys.random( 0.3 );
	while( sys.getTime() < t ) {
		sys.waitFrame();
	}
}

/*
================
monster_froginator::hop

a hop toward it, a little to one side or the other, as far as there's room
================
*/
void monster_froginator::hop() {
	vector	dir;
	vector	dest;
	vector	from;
	float	len;
	float	frac;

	from = getOrigin();
	dir = getEnemyPos() - from;
	dir_z = 0;
	dir = sys.vecNormalize( dir + sys.angToRight( '0 1 0' * getCurrentYaw() ) * ( sys.random( 0.6 ) - 0.3 ) * sys.vecLength( dir ) );
	len = getFloatKey( "hop_min" ) + sys.random( getFloatKey( "hop_max" ) - getFloatKey( "hop_min" ) );
	if ( len > enemyRange2D() ) {
		len = enemyRange2D();
	}

	// short of what's in the way (not you: it means to land on you)
	frac = sys.trace( from + '0 0 32', from + '0 0 32' + dir * len, getMins(), getMaxs(), CONTENTS_SOLID | CONTENTS_MONSTERCLIP, self );
	if ( frac * len >= 48 ) {
		dest = floorUnder( from + dir * ( frac * len - 16 ) );
		if ( throwTo( dest, getFloatKey( "hop_up" ), getFloatKey( "hop_speed" ), "jumpa" ) ) {
			crouch();
			return;
		}
	}
	// no room for a hop: on foot a moment, around what's in the way
	playCycle( ANIMCHANNEL_LEGS, "runa" );
	moveToEnemy();
	sys.wait( 0.5 );
	stopMove();
}

/*
================
monster_froginator::leapAt

at it, where it'll be when it gets there
================
*/
void monster_froginator::leapAt() {
	entity	enemy;
	vector	at;
	vector	dest;
	float	flight;

	enemy = getEnemy();
	at = enemy.getOrigin();
	flight = enemyRange2D() / getFloatKey( "leap_speed" );
	dest = at + enemy.getLinearVelocity() * flight;
	dest_z = at_z;
	if ( throwTo( dest, getFloatKey( "jump_up" ), getFloatKey( "leap_speed" ), "atakc" ) ) {
		crouch();
	} else {
		hop();
	}
}

/*
================
monster_froginator::swim

after it through the water, a second at a time
================
*/
void monster_froginator::swim() {
	playCycle( ANIMCHANNEL_LEGS, "swima" );
	moveToEnemy();
	sys.wait( 1 );
	stopMove();
}

/*
================
monster_froginator::attack

a bite, as its animation strikes
================
*/
void monster_froginator::attack() {
	float t;

	stopMove();
	faceEnemy();
	playAnim( ANIMCHANNEL_LEGS, "atakb" );
	startSound( "snd_attack", CHAN_VOICE, false );
	t = sys.getTime() + 0.6;
	while( sys.getTime() < t ) {
		sys.waitFrame();
	}
	attackMelee( "damage_frog_bite" );
	while( !animDone( ANIMCHANNEL_LEGS, 0 ) ) {
		sys.waitFrame();
	}
}

/*
================
monster_froginator::pain
================
*/
void monster_froginator::pain() {
	stopMove();
	waitAnim( "hita" );
}
