// monster_slaughterskeet.script -- Daikatana's Slaughter Skeet: a flying
// insect that crowds over you. Skeets hover close, each circling you at its
// own height and angle, dart in to bite now and then and back to their
// circle, and dodge aside when you hold your aim on them a moment (as
// Fallout's bloodbugs and stingwings do), now and then: they're quick, not
// unhittable. It flies as a drone: the game turns its thrust to where it
// goes, it keeps its momentum, banks and bounces off walls (a hard crash
// hurts it), and finds its way through the air to you when you're out of
// sight.

object monster_slaughterskeet : monster_base {
	float		circleAngle;		// where it is around you
	float		circleDir;			// which way it goes round
	float		circleRadius;
	float		circleHeight;
	float		nextBite;
	float		nextDodge;
	float		aimedSince;			// since when you've aimed at it, 0 if you haven't

	void		state_Combat();
	void		closeIn();
	void		hover();
	void		dodge();
	void		bite();
	boolean		aimedAt();
	boolean		shouldDodge();
	vector		roomTo( vector from, vector spot );
};

/*
================
monster_slaughterskeet::state_Combat
================
*/
void monster_slaughterskeet::state_Combat() {
	playCycle( ANIMCHANNEL_LEGS, "flya" );
	startSound( "snd_fly", CHAN_BODY, false );
	circleAngle = sys.random( 360 );
	circleDir = 1;
	if ( sys.random( 1 ) < 0.5 ) {
		circleDir = -1;
	}
	circleRadius = 70 + sys.random( 60 );
	circleHeight = 30 + sys.random( 50 );
	nextBite = sys.getTime() + 1.5 + sys.random( 2.5 );

	while( 1 ) {
		if ( !getEnemy() ) {
			setState( "state_Idle" );
			return;
		}
		if ( !AI_ENEMY_VISIBLE || enemyRange() > 400 ) {
			closeIn();
		} else if ( shouldDodge() ) {
			dodge();
		} else if ( sys.getTime() > nextBite ) {
			bite();
			nextBite = sys.getTime() + 2.5 + sys.random( 2.5 );
		} else {
			hover();
		}
	}
}

/*
================
monster_slaughterskeet::aimedAt

whether its enemy aims near it: its sight within about 12 degrees
================
*/
boolean monster_slaughterskeet::aimedAt() {
	entity	enemy;
	vector	eye;
	vector	toMe;
	float	dist;

	enemy = getEnemy();
	eye = enemy.getOrigin() + '0 0 24';
	toMe = getOrigin() - eye;
	dist = sys.vecLength( toMe );
	if ( dist < 1 ) {
		return false;
	}
	return ( sys.DotProduct( sys.angToForward( enemy.getAngles() ), toMe ) / dist ) > 0.978;
}

/*
================
monster_slaughterskeet::shouldDodge

aimed at a moment (a reaction's worth: quicker on hard), and not just after
a dodge; then it dodges, more likely on hard
================
*/
boolean monster_slaughterskeet::shouldDodge() {
	if ( !aimedAt() ) {
		aimedSince = 0;
		return false;
	}
	if ( !aimedSince ) {
		aimedSince = sys.getTime();
	}
	if ( sys.getTime() < nextDodge || sys.getTime() - aimedSince < 0.4 - skill * 0.1 ) {
		return false;
	}
	nextDodge = sys.getTime() + 1.2 + sys.random( 1.5 ) - skill * 0.3;
	return sys.random( 1 ) < 0.45 + skill * 0.15;
}

/*
================
monster_slaughterskeet::roomTo

as far toward spot from from as its box goes (a narrow way's walls)
================
*/
vector monster_slaughterskeet::roomTo( vector from, vector spot ) {
	vector dir;

	if ( sys.trace( from, spot, getMins(), getMaxs(), CONTENTS_SOLID | CONTENTS_MONSTERCLIP, self ) < 1 ) {
		dir = sys.vecNormalize( spot - from );
		return sys.getTraceEndPos() - dir * 8;
	}
	return spot;
}

/*
================
monster_slaughterskeet::closeIn

after it, through the air, until it's seen and near
================
*/
void monster_slaughterskeet::closeIn() {
	float t;

	setFlySpeed( getFloatKey( "fly_speed" ) );
	setFlyOffset( circleHeight );
	moveToEnemy();
	t = sys.getTime() + 10;
	while( sys.getTime() < t && getEnemy() != $null_entity ) {
		if ( AI_ENEMY_VISIBLE && enemyRange() < 300 ) {
			return;
		}
		sys.wait( 0.1 );
	}
}

/*
================
monster_slaughterskeet::hover

a little way round its circle over its enemy's head, as much of it as
there's room for
================
*/
void monster_slaughterskeet::hover() {
	vector	spot;
	vector	over;
	float	t;

	circleAngle = circleAngle + circleDir * ( 25 + sys.random( 20 ) );
	if ( sys.random( 1 ) < 0.1 ) {
		circleDir = -circleDir;
	}
	over = getEnemyPos();
	over_z = over_z + circleHeight + sys.random( 16 ) - 8;
	over = roomTo( getEnemyPos() + '0 0 16', over );
	spot = roomTo( over, over + sys.angToForward( '0 1 0' * circleAngle ) * circleRadius );
	if ( sys.vecLength( spot - over ) < circleRadius * 0.6 ) {
		// a wall on this side (a narrow way): round to the other
		circleAngle = circleAngle + 180;
		circleDir = -circleDir;
		spot = roomTo( over, over + sys.angToForward( '0 1 0' * circleAngle ) * circleRadius );
	}

	setFlySpeed( getFloatKey( "fly_speed" ) );
	setFlyOffset( 0 );
	faceEnemy();
	moveToPosition( spot );
	t = sys.getTime() + 0.3;
	while( sys.getTime() < t ) {
		if ( shouldDodge() ) {
			dodge();
			return;
		}
		sys.waitFrame();
	}
}

/*
================
monster_slaughterskeet::dodge

aside, out of its enemy's sight, fast
================
*/
void monster_slaughterskeet::dodge() {
	vector	side;
	vector	dest;
	float	t;
	entity	enemy;

	enemy = getEnemy();
	side = sys.angToRight( enemy.getAngles() );
	side_z = 0;
	if ( sys.random( 1 ) < 0.5 ) {
		side = -side;
	}
	dest = getOrigin() + side * ( 50 + sys.random( 40 ) );
	dest_z = dest_z + sys.random( 30 ) - 15;
	dest = roomTo( getOrigin(), dest );
	circleAngle = circleAngle + circleDir * 60;

	setFlySpeed( getFloatKey( "fly_speed" ) * 1.5 );
	setFlyOffset( 0 );
	moveToPosition( dest );
	t = sys.getTime() + 0.4;
	while( sys.getTime() < t && moveStatus() == MOVE_STATUS_MOVING ) {
		sys.waitFrame();
	}
}

/*
================
monster_slaughterskeet::bite

down at it until it's in reach, a bite, and up to its circle again
================
*/
void monster_slaughterskeet::bite() {
	float t;

	setFlySpeed( getFloatKey( "fly_speed" ) * 1.5 );
	setFlyOffset( 8 );
	faceEnemy();
	moveToEnemy();
	t = sys.getTime() + 2;
	while( sys.getTime() < t && getEnemy() != $null_entity ) {
		if ( testMeleeAttack() ) {
			break;
		}
		sys.waitFrame();
	}
	if ( !testMeleeAttack() ) {
		playCycle( ANIMCHANNEL_LEGS, "flya" );
		return;		// it couldn't get to it: round again
	}
	playAnim( ANIMCHANNEL_LEGS, "ataka" );
	startSound( "snd_attack", CHAN_VOICE, false );
	attackMelee( "damage_skeet_bite" );
	stopMove();
	t = sys.getTime() + 0.3;
	while( sys.getTime() < t ) {
		sys.waitFrame();
	}
	playCycle( ANIMCHANNEL_LEGS, "flya" );
}
