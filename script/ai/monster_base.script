// monster_base.script -- what every monster's script object has (Doom 3's
// ai_monster_base.script, in short): the fields the game keeps up to date
// (g_monster.c), the skill, idle until it sees someone, and death.
//
// A monster's script runs in states: setState( "state_X" ) and its
// state_X() runs from the monster's next think, in a thread of its own, as
// straight-line code that waits (sys.wait, sys.waitFrame) for what it waits for.

object monster_base {
	// kept by the game each think
	boolean		AI_ONGROUND;
	boolean		AI_PAIN;			// hurt since its last think
	boolean		AI_DEAD;
	boolean		AI_ENEMY_VISIBLE;
	boolean		AI_ENEMY_IN_FOV;
	boolean		AI_MOVE_DONE;
	boolean		AI_BLOCKED;			// its move got nowhere
	boolean		AI_IMPACT;			// it hit the world hard
	boolean		AI_IN_WATER;
	boolean		AI_LEAP_HIT;		// its leap met someone since its last think

	float		skill;				// 0 easy, 1 medium, 2 hard (g_skill)
	float		idleTime;
	float		painFinished;		// no pain again till then
	boolean		sighted;			// it has had an enemy ("sight_target" fired)
	boolean		ignorePlayer;		// a map's script has it pay you no mind (ai_ignore_player)

	void		init();
	void		state_Idle();
	void		state_Combat();
	void		state_Killed();

	void		idleAnims();
	void		sightEnemy();
	void		waitAnim( string anim );
	boolean		checkPain();
	void		pain();
	void		painDone();

	// what Daikatana's action scripts make it do (ai_actions.script)
	void		ai_ignore_player();
	void		ai_aggressive();
	void		ai_pathfollow();
	void		ai_scripted();
	void		state_PathFollow();
	void		state_Scripted();
	string		moveAnim();
};

void monster_base::init() {
	skill = sys.strToFloat( sys.getcvar( "g_skill" ) );
	setState( "state_Idle" );
}

/*
================
monster_base::waitAnim

plays it through
================
*/
void monster_base::waitAnim( string anim ) {
	playAnim( ANIMCHANNEL_LEGS, anim );
	while( !animDone( ANIMCHANNEL_LEGS, 0 ) ) {
		sys.waitFrame();
	}
}

/*
================
monster_base::checkPain

hurt: Daikatana's AI_StartPain, its pain as often as its "pain_chance" (a
fraction, 0.2 if none) says, not again till that pain's over; true if it
was in pain (what it was doing is to start again)
================
*/
boolean monster_base::checkPain() {
	float chance;

	if ( !AI_PAIN || sys.getTime() < painFinished ) {
		return false;
	}
	chance = 0.2;
	if ( getKey( "pain_chance" ) != "" ) {
		chance = getFloatKey( "pain_chance" );
	}
	if ( sys.random( 1 ) >= chance ) {
		return false;
	}
	pain();
	painDone();
	return true;
}

/*
================
monster_base::pain

its pain animation (hita, or hitb as often unless "pain_hitb" is 0: the
thunderskeet's is its ram), played through; one with
none shakes (painJolt, "pain_jolt" degrees, 10 if none): a cambot, a rockgat
================
*/
void monster_base::pain() {
	string anim;

	anim = "";
	if ( hasAnim( ANIMCHANNEL_LEGS, "hitb" ) && getKey( "pain_hitb" ) != "0" && sys.random( 1 ) < 0.5 ) {
		anim = "hitb";
	} else if ( hasAnim( ANIMCHANNEL_LEGS, "hita" ) ) {
		anim = "hita";
	}
	startSound( "snd_pain", CHAN_VOICE, false );
	if ( anim == "" ) {
		if ( getKey( "pain_jolt" ) != "" ) {
			painJolt( getFloatKey( "pain_jolt" ) );
		} else {
			painJolt( 10 );
		}
		painFinished = sys.getTime() + 0.4;
		return;
	}
	stopMove();
	waitAnim( anim );
	painFinished = sys.getTime();
}

/*
================
monster_base::painDone

after a pain: what it was doing again (its own: its move animation)
================
*/
void monster_base::painDone() {
}

/*
================
monster_base::idleAnims

its idle animation, now and then the other
================
*/
void monster_base::idleAnims() {
	if ( sys.getTime() > idleTime ) {
		idleTime = sys.getTime() + 3 + sys.random( 4 );
		if ( sys.random( 1 ) < 0.3 ) {
			startSound( "snd_idle", CHAN_VOICE, false );
		}
	}
}

/*
================
monster_base::sightEnemy
================
*/
void monster_base::sightEnemy() {
	entity target;

	startSound( "snd_sight", CHAN_VOICE, false );
	// the first time: what its "sight_target" names is used (a boss woken
	// fails a quest's objective: g_quests.c)
	if ( !sighted ) {
		sighted = true;
		if ( getKey( "sight_target" ) != "" ) {
			target = sys.getEntity( getKey( "sight_target" ) );
			if ( target ) {
				target.activate( getEnemy() );
			}
		}
	}
	setState( "state_Combat" );
}

/*
================
monster_base::state_Idle

until someone's seen, hurts it, or another monster tells it of them
================
*/
void monster_base::state_Idle() {
	entity enemy;

	stopMove();
	playCycle( ANIMCHANNEL_LEGS, "amba" );
	while( 1 ) {
		if ( !ignorePlayer ) {
			enemy = findEnemy( true );
			if ( enemy ) {
				setEnemy( enemy );
				sightEnemy();
				return;
			}
		}
		// hurt, or given an enemy (another's alarm, alertMonsters)
		if ( getEnemy() != $null_entity ) {
			sightEnemy();
			return;
		}
		idleAnims();
		sys.wait( 0.1 );
	}
}

void monster_base::state_Combat() {
	setState( "state_Idle" );
}

/*
================
monster_base::state_Killed
================
*/
void monster_base::state_Killed() {
	stopMove();
	startSound( "snd_death", CHAN_VOICE, false );
	waitAnim( "diea" );
}

/*
===============================================================================

	Daikatana's action scripts (its action.cpp, the maps' ai/maps/<map>.script):
	set_state( it, ignore_player ), ( it, aggressive ), ( it, pathfollow, corner ),
	and the actions that play it like a puppet (animate, face_angle)

===============================================================================
*/

void monster_base::ai_ignore_player() {
	ignorePlayer = true;
}

/*
================
monster_base::ai_aggressive

after you, now
================
*/
void monster_base::ai_aggressive() {
	entity enemy;

	ignorePlayer = false;
	enemy = findEnemy( false );
	if ( enemy == $null_entity ) {
		enemy = sys.getEntity( "player1" );
	}
	if ( enemy != $null_entity ) {
		setEnemy( enemy );
		setState( "state_Combat" );
	}
}

void monster_base::ai_pathfollow() {
	setState( "state_PathFollow" );
}

/*
================
monster_base::ai_scripted

it stands still for a script to play it
================
*/
void monster_base::ai_scripted() {
	if ( getState() != "state_Scripted" ) {
		setState( "state_Scripted" );
	}
}

void monster_base::state_Scripted() {
	stopMove();
	while( 1 ) {
		sys.wait( 1 );
	}
}

/*
================
monster_base::moveAnim

what it moves with on a path: the script's (set_moving_animation), else its
walk, or its flight
================
*/
string monster_base::moveAnim() {
	string anim;

	anim = getKey( "ai_moveanim" );
	if ( anim != "" ) {
		return anim;
	}
	if ( hasAnim( ANIMCHANNEL_LEGS, "walka" ) ) {
		return "walka";
	}
	if ( hasAnim( ANIMCHANNEL_LEGS, "flya" ) ) {
		return "flya";
	}
	return "runa";
}

/*
================
monster_base::state_PathFollow

from corner to corner (monster_path_corner, each its "target" the next),
"ai_arg" the first. A corner with an "aiscript" runs it as it gets there,
and that script says what's next. It goes for you if it sees you, unless
it's ignoring you, and when hurt
================
*/
void monster_base::state_PathFollow() {
	entity	corner;
	entity	next;
	entity	enemy;
	float	t;

	corner = sys.getEntity( getKey( "ai_arg" ) );
	playCycle( ANIMCHANNEL_LEGS, moveAnim() );
	if ( getFloatKey( "walk_speed" ) > 0 ) {
		setMoveSpeed( getFloatKey( "walk_speed" ) );		// walking it, as Daikatana's (flyers fly)
	}
	while( corner != $null_entity ) {
		moveToEntity( corner );
		t = sys.getTime() + 30;
		while( distanceTo( corner ) > 40 && moveStatus() == MOVE_STATUS_MOVING && sys.getTime() < t ) {
			if ( !ignorePlayer ) {
				enemy = findEnemy( true );
				if ( enemy ) {
					setEnemy( enemy );
				}
			}
			if ( getEnemy() != $null_entity && ( !ignorePlayer || AI_PAIN ) ) {
				ignorePlayer = false;
				if ( getFloatKey( "run_speed" ) > 0 ) {
					setMoveSpeed( getFloatKey( "run_speed" ) );
				}
				sightEnemy();
				return;
			}
			sys.wait( 0.1 );
		}
		next = corner.getEntityKey( "target" );
		ai_debug( getName() + " at " + corner.getName() );
		if ( corner.getKey( "aiscript" ) != "" ) {
			corner.activate( self );		// its script carries on (g_aiscript.c)
			setState( "state_Scripted" );
			return;
		}
		corner = next;
	}
	stopMove();
	if ( getFloatKey( "run_speed" ) > 0 ) {
		setMoveSpeed( getFloatKey( "run_speed" ) );
	}
	setState( "state_Idle" );
}
