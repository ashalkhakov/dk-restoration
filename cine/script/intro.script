// ours: the dump truck drives off north along the road with the coffins, as
// Daikatana's func_train carried it (its "truckgo" trigger, 300 a second);
// here the vehicle (maps/intro.ent), its engine started, then driven at about
// the pace the shot's camera follows: its wheels' motors only push (harder
// or softer, never slower), so it's driven while under the pace, let roll
// over it; and steered back to the road's middle (x -1704: left alone it
// drifts east into the wall), against how far off it is and how it heads
void truck_shot111() {
	entity	truck;
	vector	was, now, d;
	float	speed, steer;

	truck = sys.getEntity( "introtruck" );
	if ( truck == $null_entity ) {
		return;
	}
	truck.vehicleEngine( 1 );
	sys.wait( 0.5 );
	was = truck.getOrigin();
	while ( shot == 111 && !sys.skippingCinematic() ) {
		sys.wait( 0.2 );
		now = truck.getOrigin();
		d = now - was;
		speed = sys.vecLength( d ) / 0.2;
		was = now;
		steer = 0;
		if ( speed > 20 ) {
			steer = -( 0.3 * ( now_x + 1704 ) + 60 * d_x / sys.vecLength( d ) );
		}
		if ( steer > 25 ) {
			steer = 25;
		} else if ( steer < -25 ) {
			steer = -25;
		}
		if ( speed < 250 ) {
			truck.vehicleDrive( 0.3, steer );
		} else {
			truck.vehicleDrive( 0.01, steer );
		}
	}
	truck.vehicleDrive( 0, 0 );
}

