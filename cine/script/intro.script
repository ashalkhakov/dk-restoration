// intro.script -- the intro, ours: first converted from Daikatana's
// cinematic cin/scripts/intro.script by tools/cine/cine_convert.py, edited
// by hand since (one actor a character, Hiro's gi on his own rig...). Its
// shots' cameras are cameras/intro_NN.camera. Daikatana's as converted, to
// compare: ./dk cine intro, out/cine/script/intro.script (this one takes its
// place in the game).

namespace intro {

entity	fatworker;		// monster_fatworker (our fatworker): Daikatana's fat1, fatdrive
entity	hirogi;		// cine_hiro (our hirogi): Daikatana's hiro1, hiro2, hiro3, hiroally, hirodead, hirofight, hirolongtalk, tm
entity	inshiro;		// cine_inshiro (our inshiro): Daikatana's insh1, inshfight
entity	ninja;		// cine_ninja (our ninja): Daikatana's ninrun
entity	ninja_2;		// cine_ninja (our ninja): Daikatana's ninja, punch
entity	ninja_3;		// cine_ninja (our ninja): Daikatana's ninjasword
entity	osaka;		// cine_osaka (our osaka): Daikatana's oka1, osa1
entity	skinnyworker;		// monster_skinnyworker (our skinnyworker): Daikatana's skin1, skinydrive
entity	toshiro;		// cine_toshiro (our toshiro): Daikatana's tat1, tosh1, toshally, toshdie, toshfight, toshlongtalk
entity	usagi;		// cine_usagi (our usagi): Daikatana's inshvolc, usag1, usagbuild, usagsafe
float	shot;		// the shot playing: an actor's tasks of an earlier one stop
float	shotStart;

void shot1() {
	entity cam;

	cam = cine_camera( "intro_01" );
	shot = 1;
	shotStart = sys.getTime();
	sys.setCamera( cam );
	sys.waitFor( cam );
}

void hiro1_shot2() {
	hirogi = cine_enter( hirogi, "cine_hirogi", '-3488.38 -3356.88 -736.279', 0.06, "hirogi", "hiro1" );
	cine_until( shotStart + 7.5 );
	if ( shot != 2 ) { return; }
	cine_play( hirogi, "ambathnk" );
	cine_until( shotStart + 10 );
	if ( shot != 2 ) { return; }
	hirogi.stopMove();
}

