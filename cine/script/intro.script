// ours: the mihopod's green light blinks, as Daikatana's did (the dlight in
// front of it, maps/intro.ent; used, it switches)
void mihopodBlink() {
	entity light;

	light = sys.getEntity( "mihopod_light" );
	if ( light == $null_entity ) {
		return;
	}
	while ( 1 ) {
		sys.wait( 0.5 );
		sys.trigger( light );
	}
}

