	entity cam;

	cam = cine_camera( "intro_111" );
	shot = 111;
	shotStart = sys.getTime();
	sys.setCamera( cam );
	thread tm_shot111();
	thread truck_shot111();
	sys.startGlobalSound( "sounds/global/e_lightninga.wav" );
	sys.waitFor( cam );
}

