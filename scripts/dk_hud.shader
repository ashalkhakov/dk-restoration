// The status bar faces, for the HUD's CG_PLAYER_FACE (ui/dk_hud.menu):
// hud/dk/face_<model>_<state>, the state a to e from full to low health,
// f dead, g invulnerable, h invisible. A model without faces of its own
// gets those of "default". Daikatana's pictures: one set per character.

hud/dk/face_default_a
{
	nopicmip
	nomipmaps
	{
		map pics/statusbar/bottom_2_0a.tga
		blendFunc blend
		rgbGen vertex
		alphaGen vertex
	}
}

