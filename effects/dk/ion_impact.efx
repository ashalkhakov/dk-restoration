// Ion blaster bolt going off (Daikatana's Proj_Ion_Die): the we_ionexpl
// sprite dissipating over its five frames and 25 green sparkles flung all
// around.

Particle
{
	life		500
	rgb
	{
		start	1 1 1
	}
	alpha
	{
		start	1
		end		0.1
		flags	linear
	}
	size
	{
		start	4 8
	}
	shaders [ dkfx/ionexpl ]
	flags		setShaderTime
}

Particle
{
	count		25
	life		700 1100
	velocity	-450 -450 -450 450 450 450
