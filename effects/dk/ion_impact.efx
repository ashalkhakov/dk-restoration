	rgb
	{
		start	0.3 1 0.3
	}
	alpha
	{
		start	0.75
		end		0
		flags	linear
	}
	size
	{
		start	2 4
	}
	rotation	0 360
	shaders [ dkfx/sparkle1 ]
}

Light
{
	life		250
	rgb
	{
		start	0.3 1 0.4
	}
	size
	{
		start	200
		end		0
