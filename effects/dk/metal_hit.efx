// Hit on a robot (Daikatana's no-blood monsters, clientSparks in white): spark
// streaks thrown back along the shot that fall.

Tail
{
	count		6 9
	life		200 400
	origin		1
	velocity	80 -100 -100 200 100 100
	gravity		-300
	rgb
	{
		start	1 1 1 1 1 0.8
	}
	alpha
	{
		start	1
		end		0
		flags	linear
	}
	size
	{
		start	0.6 1
	}
	length
	{
		start	4 8
		end		1
		flags	linear
	}
	shaders [ dkfx/beamspark ]
	flags		usePhysics expensivePhysics
	bounce		0.3
}
